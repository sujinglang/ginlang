---
import { getCollection } from 'astro:content';
import MarginWhisper from '../../components/MarginWhisper.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { categories, categoryLabel } from '../../lib/categories';
import { formatDate } from '../../lib/date';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.category === category.slug)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const authors = new Map((await getCollection('authors')).map((author) => [author.id, author]));
const categoryArt = {
  essay: { file: 'about-notebook-animated.webp', width: 720, height: 720, alt: '手绘的摊开笔记本与一枝植物' },
  diary: { file: 'diary-moon-animated.webp', width: 720, height: 720, alt: '手绘的明亮街道与浅蓝天空中的弯月' },
  book: { file: 'archive-ginkgo-animated.webp', width: 720, height: 720, alt: '手绘的银杏叶、旧卡片与书签' },
  short: { file: 'hero-letter-animated.webp', width: 800, height: 1200, alt: '手绘的窗边信封与一枝细叶' },
}[category.slug as 'essay' | 'diary' | 'book' | 'short'];
---

<SiteLayout title={category.label} description={category.description}>
  <section class="listing-page category-page">
    <a class="back-link" href={base + '/'}>← GINLANG</a>
    <div class="intro-spread">
      <header class="page-intro">
        <p class="eyebrow">文字分类</p>
        <h1>{category.label}</h1>
        <p>{category.description}</p>
        <p class="listing-count">{String(posts.length).padStart(2, '0')} 篇文字 · 按时间慢慢排开</p>
      </header>
      <figure class="intro-art" data-reveal="image">
        <img src={base + '/' + categoryArt.file} width={categoryArt.width} height={categoryArt.height} alt={categoryArt.alt} loading="lazy" decoding="async" />
        <figcaption>从这里，翻开一页。</figcaption>
      </figure>
    </div>

    <MarginWhisper theme="category" />

    {posts.length > 0 ? (
      <ol class="post-list">
        {posts.map((post) => (
          <li class="post-row">
            <div class="post-meta">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <span class="meta-dot" aria-hidden="true">·</span>
              <span>{categoryLabel(post.data.category)}</span>
              <span class="meta-dot" aria-hidden="true">·</span>
              <a href={base + '/authors/' + post.data.author.id + '/'}>{authors.get(post.data.author.id)?.data.name}</a>
            </div>
            <a class="post-title" href={base + '/posts/' + post.id + '/'}>{post.data.title}</a>
            <p class="post-excerpt">{post.data.excerpt}</p>
            <span class="post-row-arrow" aria-hidden="true">↗</span>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty-note">这一页暂时留白。等有新的文字，再回来看看。</p>
    )}
  </section>
</SiteLayout>
