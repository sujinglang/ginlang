---
import { getCollection } from 'astro:content';
import MarginWhisper from '../components/MarginWhisper.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { categoryLabel } from '../lib/categories';
import { formatDate } from '../lib/date';
import { hasPublicAuthor } from '../lib/postVisibility';
import { collectTags, tagSlug } from '../lib/tags';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const tags = collectTags(posts);
const years = [...new Set(posts.map((post) => post.data.date.getUTCFullYear()))];
const authors = new Map((await getCollection('authors')).map((author) => [author.id, author]));
---

<SiteLayout title="归档" description="GINLANG 的文章归档。">
  <section class="listing-page archive-page">
    <a class="back-link" href={base + '/'}>← GINLANG</a>
    <div class="intro-spread">
      <header class="page-intro">
        <p class="eyebrow">慢慢积下的日子</p>
        <h1>归档</h1>
        <p>不按重要与否，只按它们来到的时间。</p>
      </header>
      <figure class="intro-art" data-reveal="image">
        <img src={base + '/archive-ginkgo-animated.webp'} width="720" height="720" alt="手绘的银杏叶、旧卡片与书签" loading="lazy" decoding="async" />
        <figcaption>把经过的日子，夹在页间。</figcaption>
      </figure>
    </div>

    <MarginWhisper theme="archive" />

    {tags.length > 0 && (
      <nav class="tag-nav" aria-label="按标签筛选归档">
        <a href={base + '/archive/'}>全部</a>
        {tags.map((tag) => (
          <a href={base + '/archive/' + tag.slug + '/'}>{tag.label}</a>
        ))}
      </nav>
    )}

    {posts.length > 0 ? years.map((year) => (
      <section class="archive-year" aria-labelledby={'year-' + year} data-reveal data-year={year}>
        <h2 id={'year-' + year}>{year}</h2>
        <ol class="archive-list">
          {posts.filter((post) => post.data.date.getUTCFullYear() === year).map((post) => (
            <li data-tags={post.data.tags.map(tagSlug).join(' ')}>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date).slice(5)}</time>
              <a href={base + '/posts/' + post.id + '/'}>{post.data.title}</a>
              <span>{categoryLabel(post.data.category)}{hasPublicAuthor(post) && <> · <a href={base + '/authors/' + post.data.author.id + '/'}>{authors.get(post.data.author.id)?.data.name}</a></>}</span>
            </li>
          ))}
        </ol>
      </section>
    )) : <p class="empty-note">还没有归档的文章。</p>}
  </section>
</SiteLayout>

<script>
  // Each tag has a real page at /archive/<slug>/, so filtering works without
  // script. This only marks the entry for the page being viewed.
  function initArchiveNav() {
    const nav = document.querySelector<HTMLElement>('.tag-nav');
    if (!nav || nav.dataset.navReady === 'true') return;
    nav.dataset.navReady = 'true';
    const here = location.pathname;
    nav.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
      if (new URL(link.href, location.origin).pathname === here) {
        link.setAttribute('aria-current', 'page');
      } else link.removeAttribute('aria-current');
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initArchiveNav, { once: true });
  else initArchiveNav();
  document.addEventListener('astro:page-load', initArchiveNav);
</script>
