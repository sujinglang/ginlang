---
import SiteLayout from '../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<SiteLayout title="相簿" description="GINLANG 的个人相簿，照片暂时还没有公开。">
  <section class="album-page">
    <a class="back-link" href={base + '/'}>← 回到首页</a>
    <header class="album-intro">
      <p>从我的相册里</p>
      <h1>相簿</h1>
    </header>
    <div class="album-empty" role="status">
      <p class="album-empty-heading">这里还空着。</p>
      <p>有一点社恐，照片先在相册里囤着。等我攒够分享的勇气，再慢慢放出来。</p>
    </div>
  </section>
</SiteLayout>

<style>
  .album-page { min-height: min(760px, 80vh); padding: 42px 0 96px; }
  .album-intro { padding: 18px 0 30px; border-bottom: 1px solid var(--line); }
  .album-intro p { margin: 0 0 10px; color: var(--accent-deep); font: 12px/1.5 var(--sans); }
  .album-intro h1 { margin: 0; font: 500 clamp(40px, 5vw, 60px)/1.25 var(--serif); }
  .album-empty { max-width: 35em; margin: clamp(100px, 16vh, 180px) auto 0; padding: 0 16px; text-align: center; }
  .album-empty-heading { margin: 0 0 16px; color: var(--ink); font: 500 27px/1.5 var(--serif); }
  .album-empty p:last-child { margin: 0; color: var(--muted); font: 16px/1.9 var(--serif); }
  @media (max-width: 680px) {
    .album-page { min-height: 70vh; padding: 31px 0 66px; }
    .album-empty { margin-top: 112px; padding-inline: 3px; }
    .album-empty-heading { font-size: 24px; }
    .album-empty p:last-child { font-size: 15px; }
  }
</style>
