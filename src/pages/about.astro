---
import { getCollection, getEntry } from 'astro:content';
import Butterfly from '../components/Butterfly.astro';
import MarginWhisper from '../components/MarginWhisper.astro';
import ProfileMeta from '../components/ProfileMeta.astro';
import ProfileQuote from '../components/ProfileQuote.astro';
import { authorSections } from '../data/author';
import SiteLayout from '../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const publishedSections = authorSections.filter((section) => section.text.trim().length > 0);
const founder = await getEntry('authors', 'ginlang');
const founderPosts = (await getCollection('posts', ({ data }) => !data.draft && data.author.id === 'ginlang'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 2);
---

<SiteLayout title="关于" description="关于 GINLANG。">
  <article class="about-page">
    <a class="back-link" href={base + '/'}>← GINLANG</a>
    <div class="intro-spread">
      <header class="page-intro">
        <p class="eyebrow">关于这里</p>
        <h1>GINLANG</h1>
        <ProfileMeta location={founder?.data.location} displayDate={founder?.data.displayDate} className="about-profile-meta" />
      </header>
      <figure class="intro-art" data-reveal="image">
        <img src={base + '/about-notebook-animated.webp'} width="720" height="720" alt="手绘的摊开笔记本与一枝植物" loading="lazy" decoding="async" />
        <figcaption>留白的地方，也可以写字。</figcaption>
        <Butterfly size="sm" />
      </figure>
    </div>
    <MarginWhisper theme="about" />
    <div class="prose about-copy">
      {founder?.data.bio && <p class="about-greeting" lang="en" translate="no">{founder.data.bio}</p>}
      {founder?.data.quote && <ProfileQuote quote={founder.data.quote} founder />}
      <p>我是 GINLANG。平时写随笔、日记，也记下读书时留下的想法。有东西想说的时候，我会更新一篇。</p>
      <p>页面留得宽松一些，方便阅读，也方便过段时间回来找一篇旧文章。</p>
      <p>这里也会陆续邀请其他作者写作。每篇作品写明作者，介绍与作品只展示作者同意公开的部分。</p>
      {publishedSections.map((section) => (
        <section aria-label={section.title}>
          <h2>{section.title}</h2>
          <p class:list={[{ 'about-placeholder': section.text === '以后再来写吧' }]}>{section.text}</p>
        </section>
      ))}

      <div class="about-card">
        <span class="about-card-label">ABOUT THE PAGES</span>
        <p>随笔记下回望，日记记下当时，书摘收着读书的回声，短句留下还不想忘记的话。</p>
      </div>
      <p><a href={base + '/authors/'}>认识写字的人</a> · <a href={base + '/contribute/'}>了解参与写作的方式</a></p>
    </div>

    <section class="about-reading-path" aria-labelledby="about-reading-path-title" data-reveal>
      <span class="folio-mark">从这里接着读</span>
      <h2 id="about-reading-path-title">回到文章里</h2>
      <p>如果想进一步认识这里，从一篇文章开始就好。</p>
      <a href={base + '/archive/'}>按时间翻阅文章</a>
      {founderPosts.length > 0 && <ul class="about-reading-list">{founderPosts.map((post) => <li><a href={base + '/posts/' + post.id + '/'}>{post.data.title}</a></li>)}</ul>}
    </section>
  </article>
</SiteLayout>
