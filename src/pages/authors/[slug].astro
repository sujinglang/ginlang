---
import { getCollection, getEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { categoryLabel } from '../../lib/categories';
import { formatDate } from '../../lib/date';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
export async function getStaticPaths() {
  return (await getCollection('authors')).map((author) => ({ params: { slug: author.id }, props: { author } }));
}
const { author } = Astro.props;
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.author.id === author.id))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const selected = author.data.featuredPost ? await getEntry(author.data.featuredPost) : posts[0];
if (author.data.featuredPost && (!selected || selected.data.author.id !== author.id || selected.data.draft)) {
  throw new Error(`作者 ${author.id} 的代表作无效或尚未发布`);
}
const bio = author.data.bio || '此处需要您亲自填写';
const siteUrl = Astro.site?.toString() ?? 'https://sujinglang.github.io';
const authorSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  inLanguage: 'zh-CN',
  url: new URL(base + '/authors/' + author.id + '/', siteUrl).toString(),
  mainEntity: {
    '@type': 'Person',
    name: author.data.name,
    description: author.data.tagline,
    url: new URL(base + '/authors/' + author.id + '/', siteUrl).toString(),
  },
}).replace(/</g, '\\u003c');
---

<SiteLayout title={author.data.name + ' · 作者'} description={author.data.tagline}>
  <script type="application/ld+json" set:html={authorSchema} />
  <article class="listing-page author-page">
    <a class="back-link" href={base + '/authors/'}>← 全部作者</a>
    <header class="author-cover">
      <div class="author-cover-art">
        {author.data.cover && <img src={base + '/' + author.data.cover.replace(/^\/+/, '')} width={author.data.coverWidth} height={author.data.coverHeight} alt={author.data.coverAlt || ''} decoding="async" fetchpriority="high" />}
      </div>
      <div class="author-identity">
        <div class="author-portrait">
          {author.data.portrait ? <img src={base + '/' + author.data.portrait.replace(/^\/+/, '')} width={author.data.portraitWidth} height={author.data.portraitHeight} alt={author.data.portraitAlt || author.data.name + '选用的头像'} decoding="async" /> : <span aria-hidden="true">{author.data.name.slice(0, 1)}</span>}
        </div>
        <p class="person-role">{author.data.role === 'founder' ? '创办人' : '客席作者'}</p>
        <h1>{author.data.name}</h1>
        <p class="author-tagline">{author.data.tagline}</p>
      </div>
    </header>
    <section class="author-about" aria-labelledby="author-about-title">
      <h2 id="author-about-title">关于</h2>
      <div>
        <p class:list={['author-bio', { 'is-placeholder': bio === '此处需要您亲自填写' }]}>{bio}</p>
        {author.data.links.length > 0 && <div class="author-links">{author.data.links.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div>}
      </div>
    </section>
    {selected && <a class="author-selected" href={base + '/posts/' + selected.id + '/'}><span>从这篇开始</span><strong>{selected.data.title}</strong><span class="author-selected-arrow" aria-hidden="true">↗</span></a>}
    <section class="author-works" aria-labelledby="works-title">
      <div class="section-heading"><h2 id="works-title">文章</h2></div>
      {posts.length ? <ol class="editorial-index">{posts.map((post) => <li><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><div><a href={base + '/posts/' + post.id + '/'}>{post.data.title}<span class="author-work-arrow" aria-hidden="true">↗</span></a><p>{post.data.excerpt}</p></div><span>{categoryLabel(post.data.category)}</span></li>)}</ol> : <p class="empty-note">这位作者的作品尚未发布。</p>}
    </section>
  </article>
</SiteLayout>
