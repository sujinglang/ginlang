---
import MarginWhisper from '../../components/MarginWhisper.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ResponsiveArt from '../../components/ResponsiveArt.astro';
import { directoryOrder, loadEditorialContent } from '../../lib/content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const authors = directoryOrder((await loadEditorialContent()).authors);
const guests = authors.filter((author) => author.data.role === 'guest');
const founders = authors.filter((author) => author.data.role === 'founder');
---

<SiteLayout title="作者" description="认识在 GINLANG 写作的人。">
  <section class="listing-page people-page">
    <a class="back-link" href={base + '/'}>← 回到首页</a>
    <header class="editorial-page-header">
      <span class="folio-mark">GINLANG / PEOPLE</span>
      <h1>作者</h1>
      <p>这里收录 GINLANG 与客席作者的介绍和公开署名作品。</p>
    </header>

    {founders.map((author) => (
      <article class="person-feature">
        <div class="person-feature-visual">
          {author.data.cover && <ResponsiveArt class="person-feature-cover" src={author.data.cover} sizes="(max-width: 1244px) 92vw, 1180px" width={author.data.coverWidth} height={author.data.coverHeight} alt="" />}
          <div class="person-feature-avatar">
            {author.data.portrait ? <ResponsiveArt src={author.data.portrait} sizes="114px" width={author.data.portraitWidth} height={author.data.portraitHeight} alt={author.data.portraitAlt || author.data.name + '选用的头像'} /> : <span aria-hidden="true">{author.data.name.slice(0, 1)}</span>}
          </div>
        </div>
        <div class="person-feature-copy">
          <p class="person-role">作者</p>
          <h2><a href={base + '/authors/' + author.id + '/'}>{author.data.name}</a></h2>
          <p>{author.data.tagline}</p>
          <a class="quiet-link" href={base + '/authors/' + author.id + '/'}>查看作者与作品</a>
        </div>
      </article>
    ))}

    <section class="people-guests" aria-labelledby="guests-title">
      <div class="section-heading"><h2 id="guests-title">客席作者</h2><span class="section-kicker">受邀写作</span></div>
      {guests.length ? (
        <div class="people-list">
          {guests.map((author) => (
            <article class="person-row">
              {author.data.portrait ? <ResponsiveArt src={author.data.portrait} sizes="80px" maxWidth={240} width={author.data.portraitWidth} height={author.data.portraitHeight} alt={author.data.portraitAlt || author.data.name + '选用的头像'} /> : <span class="person-initial" aria-hidden="true">{author.data.name.slice(0, 1)}</span>}
              <div><h3><a href={base + '/authors/' + author.id + '/'}>{author.data.name}</a></h3><p>{author.data.tagline}</p></div>
              {author.data.cover && <ResponsiveArt class="person-row-preview" src={author.data.cover} sizes="200px" maxWidth={800} width={author.data.coverWidth} height={author.data.coverHeight} alt="" />}
            </article>
          ))}
        </div>
      ) : (
        <div class="people-empty"><p>暂无客席作者。</p><a class="quiet-link" href={base + '/contribute/'}>了解参与写作的方式</a></div>
      )}
    </section>
    <MarginWhisper theme="writing" />
  </section>
</SiteLayout>
