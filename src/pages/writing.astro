---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { categories, categoryLabel } from '../lib/categories';
import { formatDate } from '../lib/date';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const authors = new Map((await getCollection('authors')).map((author) => [author.id, author]));
---

<SiteLayout title="文章" description="阅读 GINLANG 的随笔、日记、书摘与短句。">
  <section class="listing-page writing-page" data-writing-index>
    <a class="back-link" href={base + '/'}>← 回到首页</a>
    <header class="editorial-page-header"><span class="folio-mark">GINLANG / WRITING</span><h1>文章</h1><p>从一篇开始读，或者按你想看的类别慢慢找。</p></header>
    <div class="writing-filter" role="group" aria-label="按类别筛选文章">
      <button type="button" data-writing-filter="all" aria-pressed="true">全部</button>
      {categories.map((category) => <button type="button" data-writing-filter={category.slug} aria-pressed="false">{category.label}</button>)}
    </div>
    <p class="writing-filter-status" data-writing-status aria-live="polite">显示全部文章</p>
    <ol class="writing-list" data-reveal="stagger">
      {posts.map((post) => {
        const author = authors.get(post.data.author.id);
        if (!author) throw new Error(`作品 ${post.id} 引用了不存在的作者`);
        return <li class="writing-row" data-writing-category={post.data.category}>
          <div class="writing-row-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>{categoryLabel(post.data.category)}</span></div>
          <div><h2><a href={base + '/posts/' + post.id + '/'}>{post.data.title}</a></h2><p>{post.data.excerpt}</p></div>
          <a class="writing-row-author" href={base + '/authors/' + author.id + '/'}>{author.data.name}</a>
        </li>;
      })}
    </ol>
    <p class="writing-empty" data-writing-empty hidden>这一类还没有文章。可以试试别的类别。</p>
  </section>
</SiteLayout>

<script>
  function initWritingIndex() {
    const index = document.querySelector<HTMLElement>('[data-writing-index]:not([data-filter-ready])');
    if (!index) return;
    index.dataset.filterReady = 'true';
    const buttons = [...index.querySelectorAll<HTMLButtonElement>('[data-writing-filter]')];
    const rows = [...index.querySelectorAll<HTMLElement>('[data-writing-category]')];
    const status = index.querySelector<HTMLElement>('[data-writing-status]');
    const empty = index.querySelector<HTMLElement>('[data-writing-empty]');
    const allowed = new Set(buttons.map((button) => button.dataset.writingFilter));
    const labelFor = (choice: string) => buttons.find((button) => button.dataset.writingFilter === choice)?.textContent?.trim() || '全部';
    const applyFilter = (requested: string, updateUrl = false) => {
      const choice = allowed.has(requested) ? requested : 'all';
      let visible = 0;
      rows.forEach((row) => {
        row.hidden = choice !== 'all' && row.dataset.writingCategory !== choice;
        if (!row.hidden) visible += 1;
      });
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.writingFilter === choice)));
      if (status) status.textContent = choice === 'all' ? '显示全部文章' : '只显示「' + labelFor(choice) + '」';
      if (empty) empty.hidden = visible > 0;
      if (updateUrl) {
        const url = new URL(window.location.href);
        if (choice === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', choice);
        window.history.pushState(null, '', url);
      }
    };
    buttons.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.writingFilter || 'all', true)));
    window.addEventListener('popstate', () => applyFilter(new URL(window.location.href).searchParams.get('category') || 'all'));
    applyFilter(new URL(window.location.href).searchParams.get('category') || 'all');
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initWritingIndex, { once: true });
  else initWritingIndex();
  document.addEventListener('astro:page-load', initWritingIndex);
</script>
