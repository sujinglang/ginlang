---
import { getCollection } from 'astro:content';
import MarginWhisper from '../components/MarginWhisper.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { categories, categoryLabel } from '../lib/categories';
import { formatDate } from '../lib/date';
import { buildReadingRoutes, readingThemeLabels } from '../lib/readingRoutes';
import { hasPublicAuthor } from '../lib/postVisibility';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const authors = new Map((await getCollection('authors')).map((author) => [author.id, author]));
const routes = buildReadingRoutes(posts);
const counts = new Map<string, number>();
for (const post of posts) counts.set(post.data.category, (counts.get(post.data.category) || 0) + 1);
---

<SiteLayout title="文章" description="阅读 GINLANG 的随笔、日记、书摘与短句。">
  <section class="listing-page writing-page" data-writing-index>
    <a class="back-link" href={base + '/'}>← 回到首页</a>
    <header class="editorial-page-header"><span class="folio-mark">GINLANG / WRITING</span><h1>文章</h1><p>从一篇开始读，或者按你想看的类别慢慢找。</p></header>
    {routes.length > 0 && <section class="reading-routes" aria-labelledby="reading-routes-title">
      <div class="reading-routes-heading"><h2 id="reading-routes-title">主题阅读路线</h2><p>从较早的一篇开始，沿着同一个主题继续读。</p></div>
      <div class="reading-route-list">{routes.map((route) => <div class="reading-route">
        <h3>{readingThemeLabels[route.theme]}</h3>
        <ol>{route.posts.map((post, index) => <li><span>{index === 0 ? '从这里读起' : '接着读'}</span><a href={base + '/posts/' + post.id + '/'}>{post.data.title}</a></li>)}</ol>
      </div>)}</div>
    </section>}
    <div class="writing-filter" role="radiogroup" aria-label="按类别筛选文章">
      <button type="button" role="radio" aria-checked="true" data-writing-filter="all" data-count={posts.length}>全部<span class="writing-filter-count" aria-hidden="true">{posts.length}</span></button>
      {categories.map((category) => {
        const count = counts.get(category.slug) || 0;
        return <button type="button" role="radio" aria-checked="false" data-writing-filter={category.slug} data-count={count} class:list={[{ 'is-empty': count === 0 }]}>{category.label}<span class="writing-filter-count" aria-hidden="true">{count}</span></button>;
      })}
    </div>
    <p class="writing-filter-status" data-writing-status aria-live="polite">显示全部文章</p>
    <ol class="writing-list" data-reveal="stagger">
      {posts.map((post) => {
        const author = authors.get(post.data.author.id);
        if (!author) throw new Error(`作品 ${post.id} 引用了不存在的作者`);
        return <li class="writing-row" data-writing-category={post.data.category}>
          <div class="writing-row-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>{categoryLabel(post.data.category)}</span></div>
          <div><h2><a href={base + '/posts/' + post.id + '/'}>{post.data.title}</a></h2><p>{post.data.excerpt}</p></div>
          {hasPublicAuthor(post) && <a class="writing-row-author" href={base + '/authors/' + author.id + '/'}>{author.data.name}</a>}
        </li>;
      })}
    </ol>
    <p class="writing-empty" data-writing-empty hidden>这一类还没有文章。可以试试别的类别。</p>
    <MarginWhisper theme="writing" />
  </section>
</SiteLayout>

<script>
  function initWritingIndex() {
    const index = document.querySelector<HTMLElement>('[data-writing-index]:not([data-filter-ready])');
    if (!index) return;
    index.dataset.filterReady = 'true';
    const buttons = [...index.querySelectorAll<HTMLButtonElement>('[data-writing-filter]')];
    const rows = [...index.querySelectorAll<HTMLElement>('[data-writing-category]')];
    const status = index.querySelector<HTMLElement>('[data-writing-status]');
    const empty = index.querySelector<HTMLElement>('[data-writing-empty]');
    const allowed = new Set(buttons.map((button) => button.dataset.writingFilter));
    const labelFor = (choice: string) => buttons.find((button) => button.dataset.writingFilter === choice)?.textContent?.trim() || '全部';
    const applyFilter = (requested: string, updateUrl = false) => {
      const choice = allowed.has(requested) ? requested : 'all';
      let visible = 0;
      rows.forEach((row) => {
        row.hidden = choice !== 'all' && row.dataset.writingCategory !== choice;
        if (!row.hidden) visible += 1;
      });
      buttons.forEach((item) => {
        const active = item.dataset.writingFilter === choice;
        item.setAttribute('aria-checked', String(active));
        // 互斥的一组选项是单选，用 roving tabindex 只让当前项留在 Tab 序里。
        item.tabIndex = active ? 0 : -1;
      });
      if (status) status.textContent = choice === 'all' ? '显示全部文章' : '只显示「' + labelFor(choice) + '」';
      if (empty) empty.hidden = visible > 0;
      if (updateUrl) {
        const url = new URL(window.location.href);
        if (choice === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', choice);
        // 单页路由：history.state 里存着 ClientRouter 的滚动位置与来回方向，
        // 传 null 会一并抹掉，之后按「返回」时路由器会直接放弃换页。
        window.history.pushState(window.history.state, '', url);
      }
    };
    buttons.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.writingFilter || 'all', true)));
    // 单选组的方向键：左右移动选中项，Home/End 到两端。
    index.querySelector('.writing-filter')?.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(key)) return;
      const current = buttons.findIndex((button) => button === document.activeElement);
      if (current < 0) return;
      event.preventDefault();
      const next = key === 'Home' ? 0
        : key === 'End' ? buttons.length - 1
          : (current + (key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length;
      const target = buttons[next];
      if (!target) return;
      applyFilter(target.dataset.writingFilter || 'all', true);
      target.focus();
    });
    window.addEventListener('popstate', () => applyFilter(new URL(window.location.href).searchParams.get('category') || 'all'));
    applyFilter(new URL(window.location.href).searchParams.get('category') || 'all');
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initWritingIndex, { once: true });
  else initWritingIndex();
  document.addEventListener('astro:page-load', initWritingIndex);
</script>

<style>
  .reading-routes { margin: 44px 0 48px; padding: 27px 0 6px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .reading-routes-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 5px 22px; margin-bottom: 17px; }
  .reading-routes-heading h2 { margin: 0; font: 500 25px/1.5 var(--serif); }
  .reading-routes-heading p { margin: 0; color: var(--muted); font: 12px/1.7 var(--sans); }
  .reading-route-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 36px; }
  .reading-route { min-width: 0; padding: 0 0 27px; }
  .reading-route h3 { margin: 0 0 11px; color: var(--accent-deep); font: 500 18px/1.6 var(--serif); }
  .reading-route ol { margin: 0; padding: 0; list-style: none; }
  .reading-route li { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 16px; align-items: baseline; padding: 11px 0; border-top: 1px solid var(--line); }
  .reading-route li span { color: var(--muted); font: 11px/1.5 var(--sans); }
  .reading-route li a { color: var(--ink); font: 16px/1.7 var(--serif); text-decoration: none; }
  .reading-route li a:hover { color: var(--accent-deep); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 680px) { .reading-routes { margin: 30px 0 35px; } .reading-route-list { grid-template-columns: 1fr; gap: 6px; } .reading-route li { grid-template-columns: 75px minmax(0, 1fr); gap: 10px; } }
</style>
