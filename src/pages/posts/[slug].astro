---
import { getCollection, getEntry, render } from 'astro:content';
import BookmarkWidget from '../../components/BookmarkWidget.astro';
import MarginWhisper from '../../components/MarginWhisper.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { categoryLabel } from '../../lib/categories';
import { formatDate } from '../../lib/date';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const author = await getEntry(post.data.author);
if (!author) throw new Error(`作品 ${post.id} 引用了不存在的作者`);
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const postIndex = allPosts.findIndex((item) => item.id === post.id);
const newerPost = postIndex > 0 ? allPosts[postIndex - 1] : undefined;
const olderPost = postIndex >= 0 ? allPosts[postIndex + 1] : undefined;
const relatedPosts = allPosts
  .filter((item) => item.id !== post.id)
  .sort((a, b) => Number(b.data.author.id === post.data.author.id) - Number(a.data.author.id === post.data.author.id)
    || Number(b.data.category === post.data.category) - Number(a.data.category === post.data.category)
    || b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);
const siteUrl = Astro.site?.toString() ?? 'https://sujinglang.github.io';
const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.date.toISOString(),
  inLanguage: 'zh-CN',
  url: new URL(base + '/posts/' + post.id + '/', siteUrl).toString(),
  author: {
    '@type': 'Person',
    name: author.data.name,
    url: new URL(base + '/authors/' + author.id + '/', siteUrl).toString(),
  },
  publisher: { '@type': 'Organization', name: 'GINLANG', url: new URL(base + '/', siteUrl).toString() },
}).replace(/</g, '\\u003c');
---

<SiteLayout title={post.data.title} description={post.data.excerpt} articlePage={true}>
  <script type="application/ld+json" set:html={articleSchema} />
  <article class="article-page" data-article-neighbors data-neighbor-prev={olderPost ? base + '/posts/' + olderPost.id + '/' : undefined} data-neighbor-next={newerPost ? base + '/posts/' + newerPost.id + '/' : undefined}>
    <a class="back-link" href={base + '/'}>← 回到首页</a>
    <header class="article-header">
      {post.data.draft && <p class="draft-banner">草稿预览 · 这篇文章不会出现在正式网站</p>}
      <div class="post-meta article-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span class="meta-dot" aria-hidden="true">·</span>
        <a href={base + '/category/' + post.data.category + '/'}>{categoryLabel(post.data.category)}</a>
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-deck">{post.data.excerpt}</p>
      <div class="article-byline">
        <span>文 / <a href={base + '/authors/' + author.id + '/'}>{author.data.name}</a></span>
      </div>
    </header>

    <BookmarkWidget />

    {tocHeadings.length > 0 && (
      <nav class="article-toc" aria-label="文章目录">
        <p class="toc-kicker">目录</p>
        <ol>
          {tocHeadings.map((heading) => (
            <li class={'toc-depth-' + heading.depth}>
              <a href={'#' + heading.slug}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="article-body prose">
      <Content />
    </div>

    <div class="article-endmark" aria-hidden="true">✳</div>
    <div class="article-actions">
      <span>如果这篇文章也陪你停留了一会儿</span>
      <div class="article-actions-buttons">
        <button class="copy-link" id="share-post" type="button" hidden>分享这篇文章</button>
        <button class="copy-link" id="copy-link" type="button">复制文章链接</button>
      </div>
    </div>
    <span class="sr-only" id="copy-status" aria-live="polite"></span>

    <aside class="article-author" aria-label="关于作者">
      {author.data.portrait ? <img class="article-author-portrait" src={base + '/' + author.data.portrait.replace(/^\/+/, '')} width={author.data.portraitWidth} height={author.data.portraitHeight} alt="" loading="lazy" decoding="async" /> : <span class="person-initial" aria-hidden="true">{author.data.name.slice(0, 1)}</span>}
      <div><p>{author.data.role === 'founder' ? '创办人' : '客席作者'}</p><h2><a href={base + '/authors/' + author.id + '/'}>{author.data.name}</a></h2><span>{author.data.tagline}</span></div>
      <a href={base + '/authors/' + author.id + '/'}>阅读这位作者的其他作品</a>
    </aside>

    <div class="article-afterword" data-reveal="image">
      <figure class="article-tail-art">
        <img src={base + '/archive-ginkgo-animated.webp'} width="720" height="720" alt="手绘的银杏叶、旧卡片与书签" loading="lazy" decoding="async" />
        <figcaption>夹在页间的一片叶</figcaption>
      </figure>
      <MarginWhisper theme="article" />
    </div>

    <footer class="article-footer">
      <span>写于 {formatDate(post.data.date)} · {categoryLabel(post.data.category)}</span>
      <a href={base + '/archive/'}>继续翻阅归档 →</a>
    </footer>

    <nav class="article-neighbors" aria-label="相邻文章">
      {olderPost ? (
        <a class="neighbor-card" href={base + '/posts/' + olderPost.id + '/'}>
          <span>← 更早一篇</span>
          <strong>{olderPost.data.title}</strong>
        </a>
      ) : (
        <div class="neighbor-card neighbor-placeholder"><span>← 更早一篇</span><strong>从第一封信开始</strong></div>
      )}
      {newerPost ? (
        <a class="neighbor-card next" href={base + '/posts/' + newerPost.id + '/'}>
          <span>更新一篇 →</span>
          <strong>{newerPost.data.title}</strong>
        </a>
      ) : (
        <div class="neighbor-card neighbor-placeholder next"><span>更新一篇 →</span><strong>你已读到最新</strong></div>
      )}
    </nav>
    {relatedPosts.length > 0 && <section class="related-reading" aria-labelledby="related-title"><h2 id="related-title">继续阅读</h2><div>{relatedPosts.map((item) => <a href={base + '/posts/' + item.id + '/'}><span>{categoryLabel(item.data.category)}</span><strong>{item.data.title}</strong></a>)}</div></section>}
  </article>
</SiteLayout>

<script>
  function initArticleExtras() {
    const article = document.querySelector<HTMLElement>('[data-article-neighbors]:not([data-neighbors-ready])');
    if (!article) return;
    article.dataset.neighborsReady = 'true';

    const shareButton = document.querySelector<HTMLButtonElement>('#share-post');
    if (shareButton && typeof navigator.share === 'function') {
      shareButton.hidden = false;
      shareButton.addEventListener('click', async () => {
        try {
          await navigator.share({ title: document.title, url: window.location.href });
        } catch {
          // The reader simply closed the share sheet.
        }
      });
    }

    document.addEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
      const target = event.target;
      if (target instanceof HTMLElement && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) return;
      if (document.querySelector('dialog[open]')) return;
      if (event.key === 'ArrowLeft' && article.dataset.neighborPrev) {
        window.location.assign(article.dataset.neighborPrev);
      } else if (event.key === 'ArrowRight' && article.dataset.neighborNext) {
        window.location.assign(article.dataset.neighborNext);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArticleExtras, { once: true });
  } else {
    initArticleExtras();
  }
  document.addEventListener('astro:page-load', initArticleExtras);
</script>
