---
import { getCollection, getEntry, render } from 'astro:content';
import BookmarkWidget from '../../components/BookmarkWidget.astro';
import MarginWhisper from '../../components/MarginWhisper.astro';
import SaveArticle from '../../components/SaveArticle.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { categoryLabel } from '../../lib/categories';
import { formatDate } from '../../lib/date';
import { hasPublicAuthor } from '../../lib/postVisibility';
import { tagSlug } from '../../lib/tags';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const author = await getEntry(post.data.author);
if (!author) throw new Error(`作品 ${post.id} 引用了不存在的作者`);
const showAuthor = hasPublicAuthor(post);
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const postIndex = allPosts.findIndex((item) => item.id === post.id);
const newerPost = postIndex > 0 ? allPosts[postIndex - 1] : undefined;
const olderPost = postIndex >= 0 ? allPosts[postIndex + 1] : undefined;
const postTags = new Set(post.data.tags.map(tagSlug));
const sharedThemes = (item: (typeof allPosts)[number]) =>
  item.data.themes.filter((theme) => post.data.themes.includes(theme)).length;
const relatedPosts = allPosts
  .filter((item) => item.id !== post.id && item.id !== olderPost?.id && item.id !== newerPost?.id)
  .sort((a, b) => b.data.tags.filter((raw) => postTags.has(tagSlug(raw))).length - a.data.tags.filter((raw) => postTags.has(tagSlug(raw))).length
    || sharedThemes(b) - sharedThemes(a)
    || Number(b.data.category === post.data.category) - Number(a.data.category === post.data.category)
    || Number(showAuthor && hasPublicAuthor(b) && b.data.author.id === post.data.author.id) - Number(showAuthor && hasPublicAuthor(a) && a.data.author.id === post.data.author.id)
    || b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);
const siteUrl = Astro.site?.toString() ?? 'https://ginlang.vip';
const shareImage = '/og/' + post.id + '.png';
const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  image: new URL(base + shareImage, siteUrl).toString(),
  datePublished: post.data.date.toISOString(),
  inLanguage: 'zh-CN',
  url: new URL(base + '/posts/' + post.id + '/', siteUrl).toString(),
  ...(showAuthor ? { author: {
    '@type': 'Person',
    name: author.data.name,
    url: new URL(base + '/authors/' + author.id + '/', siteUrl).toString(),
  } } : {}),
  publisher: { '@type': 'Organization', name: 'GINLANG', url: new URL(base + '/', siteUrl).toString() },
}).replace(/</g, '\\u003c');
---

<SiteLayout title={post.data.title} description={post.data.excerpt} articlePage={true} ogImage={shareImage}>
  <script type="application/ld+json" set:html={articleSchema} />
  <article class="article-page" data-article-neighbors data-post-id={post.id} data-post-title={post.data.title} data-neighbor-prev={olderPost ? base + '/posts/' + olderPost.id + '/' : undefined} data-neighbor-next={newerPost ? base + '/posts/' + newerPost.id + '/' : undefined}>
    <a class="back-link" href={base + '/'}>← 回到首页</a>
    <header class="article-header">
      {post.data.draft && <p class="draft-banner">草稿预览 · 这篇文章不会出现在正式网站</p>}
      <div class="post-meta article-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span class="meta-dot" aria-hidden="true">·</span>
        <a href={base + '/category/' + post.data.category + '/'}>{categoryLabel(post.data.category)}</a>
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-deck">{post.data.excerpt}</p>
      {post.data.tags.length > 0 && (
        <p class="post-meta article-tags">
          <span class="article-tags-label">标签</span>
          {post.data.tags.map((raw) => (
            <a href={base + '/tags/' + tagSlug(raw) + '/'}>{raw.trim()}</a>
          ))}
        </p>
      )}
      {showAuthor && <div class="article-byline">
        <span>文 / <a href={base + '/authors/' + author.id + '/'}>{author.data.name}</a></span>
      </div>}
    </header>

    <SaveArticle postId={post.id} />

    <BookmarkWidget />

    {tocHeadings.length > 0 && (
      <nav class="article-toc" aria-label="文章目录">
        <p class="toc-kicker">目录</p>
        <ol>
          {tocHeadings.map((heading) => (
            <li class={'toc-depth-' + heading.depth}>
              <a href={'#' + heading.slug}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="article-body prose">
      <Content />
    </div>

    <div class="article-endmark" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" focusable="false"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M5.6 18.4L18.4 5.6" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" /></svg></div>
    <div class="article-actions">
      <span>如果这篇文章也陪你停留了一会儿</span>
      <div class="article-actions-buttons">
        <button class="copy-link" id="share-post" type="button" hidden>分享这篇文章</button>
        <button class="copy-link" id="copy-link" type="button">复制文章链接</button>
      </div>
    </div>
    <span class="sr-only" id="copy-status" aria-live="polite"></span>

    {showAuthor && <aside class="article-author" aria-label="关于作者">
      {author.data.portrait ? <img class="article-author-portrait" src={base + '/' + author.data.portrait.replace(/^\/+/, '')} width={author.data.portraitWidth} height={author.data.portraitHeight} alt="" loading="lazy" decoding="async" /> : <span class="person-initial" aria-hidden="true">{author.data.name.slice(0, 1)}</span>}
      <div><p>{author.data.role === 'founder' ? '作者' : '客席作者'}</p><h2><a href={base + '/authors/' + author.id + '/'}>{author.data.name}</a></h2><span>{author.data.tagline}</span></div>
      <a href={base + '/authors/' + author.id + '/'}>阅读这位作者的其他作品</a>
    </aside>}

    <div class="article-afterword" data-reveal="image">
      <figure class="article-tail-art">
        <img src={base + '/archive-ginkgo-animated.webp'} width="720" height="720" alt="手绘的银杏叶、旧卡片与书签" loading="lazy" decoding="async" />
      </figure>
      <MarginWhisper theme="article" />
    </div>

    <footer class="article-footer">
      <span>写于 {formatDate(post.data.date)} · {categoryLabel(post.data.category)}</span>
      <a href={base + '/archive/'}>继续翻阅归档 →</a>
    </footer>

    <nav class="article-neighbors" aria-label="相邻文章">
      {olderPost ? (
        <a class="neighbor-card" href={base + '/posts/' + olderPost.id + '/'}>
          <span>← 更早一篇</span>
          <strong>{olderPost.data.title}</strong>
        </a>
      ) : (
        <div class="neighbor-card neighbor-placeholder"><span>← 更早一篇</span><strong>从第一封信开始</strong></div>
      )}
      {newerPost ? (
        <a class="neighbor-card next" href={base + '/posts/' + newerPost.id + '/'}>
          <span>更新一篇 →</span>
          <strong>{newerPost.data.title}</strong>
        </a>
      ) : (
        <div class="neighbor-card neighbor-placeholder next"><span>更新一篇 →</span><strong>你已读到最新</strong></div>
      )}
    </nav>
    {relatedPosts.length > 0 && <section class="related-reading" aria-labelledby="related-title"><h2 id="related-title">继续阅读</h2><div>{relatedPosts.map((item) => <a href={base + '/posts/' + item.id + '/'}><span>{categoryLabel(item.data.category)}</span><strong>{item.data.title}</strong></a>)}</div></section>}
  </article>
</SiteLayout>

<script>
  function initArticleExtras() {
    const article = document.querySelector<HTMLElement>('[data-article-neighbors]:not([data-neighbors-ready])');
    if (!article) return;
    article.dataset.neighborsReady = 'true';

    // Leave a quiet local trace so the home page can show where reading stopped.
    if (article.dataset.postId && article.dataset.postTitle) {
      try {
        localStorage.setItem('ginlang-last-read', JSON.stringify({
          id: article.dataset.postId,
          title: article.dataset.postTitle,
          at: new Date().toISOString(),
        }));
      } catch { /* Storage is optional. */ }
    }

    // Follow the section the reader is in, and mark it in the table of contents.
    const toc = document.querySelector<HTMLElement>('.article-toc');
    const tocLinks = toc ? [...toc.querySelectorAll<HTMLAnchorElement>('a')] : [];
    const tocPairs = tocLinks
      .map((link) => ({ link, heading: document.getElementById((link.getAttribute('href') || '').slice(1)) }))
      .filter((pair): pair is { link: HTMLAnchorElement; heading: Element } => Boolean(pair.heading));
    if (tocPairs.length) {
      let currentId = '';
      let tocFrame = 0;
      const updateToc = () => {
        tocFrame = 0;
        // Just below the 84px anchor offset, so scrolling to a heading highlights it.
        const sightLine = 132;
        let active: Element | null = null;
        for (const pair of tocPairs) {
          if (pair.heading.getBoundingClientRect().top <= sightLine) active = pair.heading;
          else break;
        }
        const nextId = active?.id ?? '';
        if (nextId === currentId) return;
        currentId = nextId;
        for (const pair of tocPairs) {
          if (pair.heading.id === currentId) pair.link.setAttribute('aria-current', 'location');
          else pair.link.removeAttribute('aria-current');
        }
      };
      window.addEventListener('scroll', () => {
        if (!tocFrame) tocFrame = window.requestAnimationFrame(updateToc);
      }, { passive: true });
      window.addEventListener('resize', updateToc, { passive: true });
      updateToc();
    }

    const shareButton = document.querySelector<HTMLButtonElement>('#share-post');
    if (shareButton && typeof navigator.share === 'function') {
      shareButton.hidden = false;
      shareButton.addEventListener('click', async () => {
        try {
          await navigator.share({ title: document.title, url: window.location.href });
        } catch {
          // The reader simply closed the share sheet.
        }
      });
    }

    document.addEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
      const target = event.target;
      if (target instanceof HTMLElement && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) return;
      if (document.querySelector('dialog[open]')) return;
      if (event.key === 'ArrowLeft' && article.dataset.neighborPrev) {
        window.location.assign(article.dataset.neighborPrev);
      } else if (event.key === 'ArrowRight' && article.dataset.neighborNext) {
        window.location.assign(article.dataset.neighborNext);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArticleExtras, { once: true });
  } else {
    initArticleExtras();
  }
  document.addEventListener('astro:page-load', initArticleExtras);
</script>
