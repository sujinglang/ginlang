---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { categoryLabel } from '../lib/categories';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('posts', ({ data }) => !data.draft)).map((post) => ({
  id: post.id,
  title: post.data.title,
  category: categoryLabel(post.data.category),
  url: base + '/posts/' + post.id + '/',
}));
---

<SiteLayout title="我的书桌" description="保存在当前浏览器里的文章、书签与今日笺。">
  <section class="desk-page" data-reading-desk data-posts={JSON.stringify(posts)}>
    <a class="back-link" href={base + '/'}>← 回到首页</a>
    <header class="desk-intro">
      <span class="folio-mark">A READING DESK</span>
      <h1>我的书桌</h1>
      <p>读过的文章、夹过的书签和写下的今日笺，放在同一处。它们只保存在当前浏览器。</p>
    </header>
    <div class="desk-actions">
      <button type="button" data-desk-export hidden>导出我的书桌</button>
      <button type="button" data-desk-backup hidden>备份为 JSON</button>
      <span role="status" aria-live="polite" data-desk-status></span>
    </div>
    <div class="desk-restore-row">
      <p class="desk-restore-note">换一台浏览器？用备份文件把收藏、阅读位置和笺语草稿带过去。</p>
      <label class="desk-import" data-desk-import-label>从备份恢复<input type="file" accept="application/json,.json" data-desk-import /></label>
    </div>
    <div class="desk-restore" data-desk-restore hidden>
      <p data-desk-restore-summary></p>
      <div class="desk-restore-actions">
        <button type="button" data-desk-restore-confirm>合并恢复</button>
        <button type="button" data-desk-restore-cancel>取消</button>
      </div>
    </div>
    <section class="desk-section" aria-labelledby="desk-saved-title">
      <div class="desk-heading"><h2 id="desk-saved-title">留下的文章</h2><a href={base + '/writing/'}>去文章里看看</a></div>
      <p class="desk-empty" data-saved-empty>还没有存下文章。读到想回来的那篇，可以在文章页放进书桌。</p>
      <ul data-saved-list></ul>
    </section>
    <section class="desk-section" aria-labelledby="desk-bookmarks-title">
      <div class="desk-heading"><h2 id="desk-bookmarks-title">夹过的书签</h2></div>
      <p class="desk-empty" data-bookmarks-empty>还没有阅读书签。读文章时可以把当前页夹起来。</p>
      <ul data-bookmarks-list></ul>
    </section>
    <section class="desk-section" aria-labelledby="desk-notes-title">
      <div class="desk-heading"><h2 id="desk-notes-title">今日笺草稿</h2><a href={base + '/#daily-note-title'}>回到今日笺</a></div>
      <p class="desk-empty" data-notes-empty>这里还没有草稿。写下的每一张今日笺都会留在这里。</p>
      <ul data-notes-list></ul>
    </section>
  </section>
</SiteLayout>

<script>
  type Post = { id: string; title: string; category: string; url: string };
  type Note = { prompt: string; text: string; updatedAt: string };
  const savedKey = 'ginlang-saved-posts-v1';
  const notesKey = 'ginlang-reader-notes-v1';
  const bookmarkPrefix = 'ginlang-reading-bookmark:';
  const backupVersion = 1;
  const readArray = (key: string): unknown[] => {
    try { const value = JSON.parse(localStorage.getItem(key) || '[]'); return Array.isArray(value) ? value : []; }
    catch { return []; }
  };

  function initReadingDesk() {
    const root = document.querySelector<HTMLElement>('[data-reading-desk]:not([data-desk-ready])');
    if (!root) return;
    root.dataset.deskReady = 'true';
    const catalog: Post[] = JSON.parse(root.dataset.posts || '[]');
    const known = new Map(catalog.map((post) => [post.id, post]));
    const savedList = root.querySelector<HTMLUListElement>('[data-saved-list]');
    const bookmarkList = root.querySelector<HTMLUListElement>('[data-bookmarks-list]');
    const notesList = root.querySelector<HTMLUListElement>('[data-notes-list]');
    const exportButton = root.querySelector<HTMLButtonElement>('[data-desk-export]');
    const backupButton = root.querySelector<HTMLButtonElement>('[data-desk-backup]');
    const importInput = root.querySelector<HTMLInputElement>('[data-desk-import]');
    const restorePanel = root.querySelector<HTMLElement>('[data-desk-restore]');
    const restoreSummary = root.querySelector<HTMLElement>('[data-desk-restore-summary]');
    const restoreConfirm = root.querySelector<HTMLButtonElement>('[data-desk-restore-confirm]');
    const restoreCancel = root.querySelector<HTMLButtonElement>('[data-desk-restore-cancel]');
    const status = root.querySelector<HTMLElement>('[data-desk-status]');
    if (!savedList || !bookmarkList || !notesList || !exportButton || !backupButton || !importInput || !restorePanel || !restoreSummary || !restoreConfirm || !restoreCancel || !status) return;

    const savedIds = () => readArray(savedKey).filter((id): id is string => typeof id === 'string' && known.has(id));
    const notes = () => readArray(notesKey).filter((item): item is Note =>
      typeof (item as Note)?.prompt === 'string' && typeof (item as Note)?.text === 'string' && typeof (item as Note)?.updatedAt === 'string');
    const bookmarks = () => catalog.filter((post) => {
      try { return localStorage.getItem(bookmarkPrefix + post.url) !== null; }
      catch { return false; }
    });
    const makeLink = (post: Post) => {
      const link = document.createElement('a');
      link.href = post.url;
      link.textContent = post.title;
      return link;
    };
    const setEmpty = (selector: string, empty: boolean) => {
      const element = root.querySelector<HTMLElement>(selector);
      if (element) element.hidden = !empty;
    };
    const render = () => {
      const saved = savedIds();
      const marked = bookmarks();
      const drafts = notes();
      savedList.replaceChildren();
      bookmarkList.replaceChildren();
      notesList.replaceChildren();
      setEmpty('[data-saved-empty]', !saved.length);
      setEmpty('[data-bookmarks-empty]', !marked.length);
      setEmpty('[data-notes-empty]', !drafts.length);
      exportButton.hidden = !saved.length && !marked.length && !drafts.length;
      backupButton.hidden = exportButton.hidden;
      // A fresh desk has nothing to export or back up; hide the whole row so it
      // does not leave a stray rule above the restore entry.
      const actions = exportButton.parentElement;
      if (actions) actions.dataset.empty = String(exportButton.hidden);

      saved.forEach((id) => {
        const post = known.get(id)!;
        const row = document.createElement('li');
        const info = document.createElement('div');
        const category = document.createElement('small');
        const remove = document.createElement('button');
        category.textContent = post.category;
        info.append(category, makeLink(post));
        remove.type = 'button';
        remove.textContent = '取下';
        remove.setAttribute('aria-label', `从书桌取下《${post.title}》`);
        remove.addEventListener('click', () => {
          try { localStorage.setItem(savedKey, JSON.stringify(savedIds().filter((item) => item !== id))); render(); status.textContent = '文章已取下'; }
          catch { status.textContent = '当前浏览器无法保存更改'; }
        });
        row.append(info, remove);
        savedList.append(row);
      });
      marked.forEach((post) => {
        const row = document.createElement('li');
        const info = document.createElement('div');
        const label = document.createElement('small');
        label.textContent = '阅读书签';
        info.append(label, makeLink(post));
        row.append(info);
        bookmarkList.append(row);
      });
      drafts.sort((a, b) => b.updatedAt.localeCompare(a.updatedAt)).forEach((note) => {
        const row = document.createElement('li');
        row.className = 'desk-note-row';
        const lead = document.createElement('p');
        const field = document.createElement('textarea');
        const remove = document.createElement('button');
        lead.textContent = note.prompt;
        field.value = note.text;
        field.rows = 4;
        field.setAttribute('aria-label', '编辑这张今日笺的草稿');
        field.addEventListener('input', () => {
          note.text = field.value;
          note.updatedAt = new Date().toISOString();
          try { localStorage.setItem(notesKey, JSON.stringify(notes().map((item) => item.prompt === note.prompt ? note : item))); status.textContent = '草稿已保存'; }
          catch { status.textContent = '当前浏览器无法保存更改'; }
        });
        remove.type = 'button';
        remove.textContent = '删除草稿';
        remove.addEventListener('click', () => {
          if (remove.dataset.confirm !== 'true') {
            remove.dataset.confirm = 'true';
            remove.textContent = '再次点击以删除';
            window.setTimeout(() => { if (remove.isConnected) { remove.dataset.confirm = 'false'; remove.textContent = '删除草稿'; } }, 4000);
            return;
          }
          try { localStorage.setItem(notesKey, JSON.stringify(notes().filter((item) => item.prompt !== note.prompt))); render(); status.textContent = '草稿已删除'; }
          catch { status.textContent = '当前浏览器无法保存更改'; }
        });
        row.append(lead, field, remove);
        notesList.append(row);
      });
    };

    exportButton.addEventListener('click', () => {
      const saved = savedIds().map((id) => known.get(id)!).filter(Boolean);
      const marked = bookmarks();
      const drafts = notes();
      const lines = ['# 我的书桌', '', '## 留下的文章', ...saved.map((post) => `- [${post.title}](${new URL(post.url, location.origin)})`), '', '## 阅读书签', ...marked.map((post) => `- [${post.title}](${new URL(post.url, location.origin)})`), '', '## 今日笺草稿'];
      drafts.forEach((note) => lines.push('', `### ${note.prompt}`, '', note.text));
      const url = URL.createObjectURL(new Blob([lines.join('\n') + '\n'], { type: 'text/markdown;charset=utf-8' }));
      const link = document.createElement('a');
      link.href = url;
      link.download = 'ginlang-我的书桌.md';
      link.click();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      status.textContent = '书桌已导出为 Markdown 文件';
    });

    // A backup carries the reading record itself, so the desk can be restored
    // in another browser. Version 1 stores post ids, bookmark ratios and drafts.
    type Backup = {
      version: number;
      exportedAt: string;
      saved: string[];
      bookmarks: { url: string; ratio: number }[];
      notes: Note[];
    };
    const collectBookmarks = (): { url: string; ratio: number }[] => {
      const rows: { url: string; ratio: number }[] = [];
      for (const post of bookmarks()) {
        try {
          const raw = localStorage.getItem(bookmarkPrefix + post.url);
          const ratio = Number(raw);
          rows.push({ url: post.url, ratio: Number.isFinite(ratio) && ratio >= 0 && ratio <= 1 ? ratio : 0 });
        } catch { /* unreadable marker: keep the bookmark without a position */ }
      }
      return rows;
    };
    const download = (name: string, type: string, data: string) => {
      const url = URL.createObjectURL(new Blob([data], { type }));
      const link = document.createElement('a');
      link.href = url;
      link.download = name;
      link.click();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
    };
    backupButton.addEventListener('click', () => {
      const payload: Backup = {
        version: backupVersion,
        exportedAt: new Date().toISOString(),
        saved: savedIds(),
        bookmarks: collectBookmarks(),
        notes: notes(),
      };
      const stamp = new Date().toISOString().slice(0, 10);
      download(`ginlang-书桌备份-${stamp}.json`, 'application/json;charset=utf-8', JSON.stringify(payload, null, 2));
      status.textContent = '书桌已备份为 JSON 文件';
    });

    let pending: Backup | null = null;
    const closeRestore = () => { pending = null; restorePanel.hidden = true; importInput.value = ''; };
    const describe = (incoming: Backup) => {
      const currentSaved = new Set(savedIds());
      const currentUrls = new Set(bookmarks().map((post) => post.url));
      const currentNotes = new Set(notes().map((note) => note.prompt));
      const newSaved = incoming.saved.filter((id) => known.has(id) && !currentSaved.has(id));
      const newMarks = incoming.bookmarks.filter((row) => knownUrl(row.url) && !currentUrls.has(row.url));
      const newNotes = incoming.notes.filter((note) => !currentNotes.has(note.prompt));
      return { newSaved, newMarks, newNotes };
    };
    const knownUrl = (url: string) => catalog.some((post) => post.url === url);

    importInput.addEventListener('change', () => {
      const file = importInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        let parsed: unknown;
        try { parsed = JSON.parse(String(reader.result)); }
        catch { status.textContent = '这个文件不是有效的 JSON 备份'; return; }
        const data = parsed as Partial<Backup>;
        if (data?.version !== backupVersion) {
          status.textContent = `备份版本无法读取（需要版本 ${backupVersion}）`;
          return;
        }
        const incoming: Backup = {
          version: backupVersion,
          exportedAt: typeof data.exportedAt === 'string' ? data.exportedAt : '',
          saved: Array.isArray(data.saved) ? data.saved.filter((id): id is string => typeof id === 'string') : [],
          bookmarks: Array.isArray(data.bookmarks) ? data.bookmarks.filter((row): row is { url: string; ratio: number } =>
            typeof row?.url === 'string' && Number.isFinite(Number(row?.ratio))) : [],
          notes: Array.isArray(data.notes) ? data.notes.filter((note): note is Note =>
            typeof note?.prompt === 'string' && typeof note?.text === 'string') : [],
        };
        const counts = describe(incoming);
        if (!counts.newSaved.length && !counts.newMarks.length && !counts.newNotes.length) {
          status.textContent = '这个备份里的内容都已经在书桌上了';
          return;
        }
        pending = incoming;
        const when = incoming.exportedAt ? new Date(incoming.exportedAt).toLocaleDateString('zh-CN') : '未知日期';
        restoreSummary.textContent =
          `这份备份来自 ${when}：将新增 ${counts.newSaved.length} 篇文章、${counts.newMarks.length} 个阅读书签、${counts.newNotes.length} 份今日笺草稿。已有的内容不会被删除。`;
        restorePanel.hidden = false;
        status.textContent = '';
      };
      reader.readAsText(file);
    });
    restoreCancel.addEventListener('click', closeRestore);
    restoreConfirm.addEventListener('click', () => {
      if (!pending) return;
      const incoming = pending;
      try {
        // Merge by identity so importing the same file twice changes nothing.
        const mergedSaved = [...new Set([...savedIds(), ...incoming.saved.filter((id) => known.has(id))])];
        localStorage.setItem(savedKey, JSON.stringify(mergedSaved));
        for (const row of incoming.bookmarks) {
          if (!knownUrl(row.url) || localStorage.getItem(bookmarkPrefix + row.url) !== null) continue;
          localStorage.setItem(bookmarkPrefix + row.url, row.ratio.toFixed(4));
        }
        const mergedNotes = [...notes()];
        for (const note of incoming.notes) {
          const existing = mergedNotes.find((item) => item.prompt === note.prompt);
          if (existing) {
            if ((note.updatedAt || '') > (existing.updatedAt || '')) { existing.text = note.text; existing.updatedAt = note.updatedAt; }
          } else mergedNotes.push({ prompt: note.prompt, text: note.text, updatedAt: note.updatedAt || new Date().toISOString() });
        }
        localStorage.setItem(notesKey, JSON.stringify(mergedNotes));
        render();
        status.textContent = '备份已合并到当前书桌';
        closeRestore();
      } catch { status.textContent = '当前浏览器无法保存更改'; }
    });
    render();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initReadingDesk, { once: true });
  else initReadingDesk();
  document.addEventListener('astro:page-load', initReadingDesk);
</script>

<style>
  .desk-page { max-width: 830px; margin: 0 auto; padding: 38px 0 96px; }
  .desk-intro { max-width: 620px; padding: 34px 0 40px; }
  .desk-intro h1 { margin: 13px 0 16px; font: 500 clamp(38px, 5vw, 58px)/1.25 var(--serif); }
  .desk-intro p { margin: 0; color: var(--muted); font: 16px/1.9 var(--serif); }
  /* Actions, the restore row and each section are separate blocks; the thin
     rules inside them do the dividing, so the page needs air between them. */
  .desk-actions { display: flex; align-items: center; gap: 20px; min-height: 52px; margin-top: 8px; border-top: 1px solid var(--line); }
  .desk-actions[data-empty='true'] { display: none; }
  /* The rows below are built by script, so these rules cannot be scoped. */
  :global(.desk-actions button), :global(.desk-heading a), :global(.desk-section button) { min-height: 44px; padding: 7px 0; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--accent-deep); cursor: pointer; font: 12px/1.6 var(--sans); text-decoration: none; }
  :global(.desk-actions button:hover), :global(.desk-heading a:hover), :global(.desk-section button:hover) { border-bottom-color: var(--clay); color: var(--ink); }
  :global(.desk-actions button:focus-visible), :global(.desk-section button:focus-visible) { outline: 2px solid var(--focus); outline-offset: 3px; }
  .desk-actions span { color: var(--muted); font: 11px/1.5 var(--sans); }
  .desk-import { display: inline-flex; align-items: center; min-height: 44px; padding: 7px 0; border-bottom: 1px solid var(--line); color: var(--accent-deep); cursor: pointer; font: 12px/1.6 var(--sans); white-space: nowrap; }
  .desk-import:hover { border-bottom-color: var(--clay); color: var(--ink); }
  .desk-restore-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 22px; margin-top: 14px; }
  .desk-restore-note { flex: 1 1 300px; margin: 0; color: var(--muted); font: 13px/1.8 var(--serif); }
  .desk-import input { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .desk-import input:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .desk-import:has(input:focus-visible) { border-bottom-color: var(--clay); color: var(--ink); }
  .desk-restore { padding: 18px 0 4px; border-bottom: 1px solid var(--line); }
  .desk-restore p { margin: 0 0 14px; color: var(--muted); font: 14px/1.85 var(--serif); }
  .desk-restore-actions { display: flex; align-items: center; gap: 22px; }
  .desk-restore-actions button { min-height: 44px; padding: 7px 0; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--accent-deep); cursor: pointer; font: 12px/1.6 var(--sans); }
  .desk-restore-actions button:hover { border-bottom-color: var(--clay); color: var(--ink); }
  .desk-restore-actions button:first-child { color: var(--ink); }
  /* Each section is its own block: a top rule with air on both sides, so the
     page does not read as one continuous stack. */
  .desk-section { margin-top: 46px; padding-top: 42px; border-top: 1px solid var(--line); }
  .desk-restore-row + .desk-section { margin-top: 0; }
  .desk-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 15px; }
  .desk-heading h2 { margin: 0; font: 500 27px/1.4 var(--serif); }
  .desk-empty { margin: 23px 0 10px; color: var(--muted); font: 14px/1.8 var(--serif); }
  /* Lists and rows are built by script, so these rules cannot be scoped. */
  :global(.desk-section ul) { margin: 19px 0 0; padding: 0; list-style: none; }
  :global(.desk-section li) { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 16px 0; border-top: 1px solid var(--line); }
  :global(.desk-section li > div) { display: grid; gap: 6px; min-width: 0; }
  :global(.desk-section li small) { color: var(--muted); font: 11px/1.5 var(--sans); }
  :global(.desk-section li a) { color: var(--ink); font: 19px/1.5 var(--serif); text-decoration: none; }
  :global(.desk-section li a:hover) { color: var(--accent-deep); text-decoration: underline; text-underline-offset: 5px; }
  :global(.desk-section .desk-note-row) { display: grid; justify-content: stretch; gap: 13px; }
  :global(.desk-note-row p) { margin: 0; color: var(--muted); font: 14px/1.85 var(--serif); }
  :global(.desk-note-row textarea) { width: 100%; min-height: 110px; resize: vertical; padding: 12px; border: 1px solid var(--line); background: var(--paper-raised); color: var(--ink); font: 15px/1.8 var(--serif); }
  :global(.desk-note-row button) { justify-self: end; }
  @media (max-width: 680px) { .desk-page { padding: 30px 0 72px; } .desk-section { padding-top: 33px; } .desk-heading h2 { font-size: 23px; } .desk-section li a { font-size: 17px; } }
</style>
