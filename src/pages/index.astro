---
import { getCollection } from 'astro:content';
import HeroGallery from '../components/HeroGallery.astro';
import DailyNote from '../components/DailyNote.astro';
import MarginWhisper from '../components/MarginWhisper.astro';
import ProfileMeta from '../components/ProfileMeta.astro';
import ProfileQuote from '../components/ProfileQuote.astro';
import topicRecords from '../content/topics.json';
import SiteLayout from '../layouts/SiteLayout.astro';
import { categories, categoryLabel } from '../lib/categories';
import { formatDate } from '../lib/date';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const allPosts = await getCollection('posts');
const posts = allPosts.filter((post) => !post.data.draft).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const authors = await getCollection('authors');
const authorById = new Map(authors.map((author) => [author.id, author]));
const postById = new Map(allPosts.map((post) => [post.id, post]));
for (const post of allPosts) {
  if (!authorById.has(post.data.author.id)) throw new Error(`作品 ${post.id} 引用了不存在的作者 ${post.data.author.id}`);
}
for (const author of authors) {
  if (!author.data.featuredPost) continue;
  const selected = postById.get(author.data.featuredPost.id);
  if (!selected || selected.data.author.id !== author.id || selected.data.draft) throw new Error(`作者 ${author.id} 的代表作无效或尚未发布`);
}
const founder = authors.find((author) => author.data.role === 'founder');
const guests = authors.filter((author) => author.data.role === 'guest' && author.data.featured).sort((a, b) => a.data.order - b.data.order);
const allTopics = Object.keys(topicRecords).length ? await getCollection('topics') : [];
for (const topic of allTopics) {
  for (const reference of topic.data.posts) {
    const post = postById.get(reference.id);
    if (!post || (!topic.data.draft && post.data.draft)) throw new Error(`专题 ${topic.id} 引用了不存在或未发布的作品 ${reference.id}`);
  }
}
const topics = allTopics.filter((topic) => !topic.data.draft).sort((a, b) => a.data.order - b.data.order);
const latest = posts[0];
// Show as much as the home can hold: the featured post plus up to five briefs.
const earlierPosts = posts.slice(1, 6);
const postUrls = posts.map((post) => base + '/posts/' + post.id + '/');
const plainText = (markdown: string) => markdown
  .replace(/!\[[^\]]*\]\([^)]+\)/g, '')
  .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
  .replace(/<[^>]+>/g, '')
  .replace(/[#*_`>~]/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const bodyParagraphs = latest?.body?.trim().split(/\n\s*\n/).map(plainText).filter(Boolean) ?? [];
const featuredSource = bodyParagraphs.slice(1).join(' ') || bodyParagraphs.join(' ') || latest?.data.excerpt || '';
const featuredCharacters = Array.from(featuredSource);
const featuredExcerpt = featuredCharacters.slice(0, 140).join('') + (featuredCharacters.length > 140 ? '…' : '');
const landscapes = [
  { label: '海边', caption: '海边 · 清晨', file: 'sea-morning-animated.webp', width: 1400, height: 788, alt: '手绘的浅蓝海岸与清晨天空' },
  { label: '林间', caption: '林间 · 流水', file: 'forest-waterfall-animated.webp', width: 1400, height: 933, alt: '手绘的林间瀑布与浅色水潭' },
  { label: '街角', caption: '街角 · 一弯月', file: 'diary-moon-animated.webp', width: 720, height: 720, alt: '手绘的明亮街道与浅蓝天空中的弯月' },
];
---

<SiteLayout description="GINLANG 的个人博客。记录随笔、日记和读书时的想法。">
  <section class="home-intro" aria-labelledby="home-title">
    <div class="hero-kicker">
      <span>个人博客</span>
      <span>2026 · GINLANG</span>
    </div>
    <div class="home-hero">
      <div>
        <h1 id="home-title" class="cover-poem"><span class="hero-line">吹箫凌极浦，</span><span class="hero-line">日暮送夫君</span><span class="hero-line">湖上一回首，</span><span class="hero-line">青山卷白云</span></h1>
        <p class="intro-note">我是 GINLANG。这里放我写的随笔、日记和读书笔记，偶尔也会邀请朋友来写。</p>
        <div class="hero-links">
          <a class="hero-link" href="#latest-title">开始阅读</a>
          <a class="hero-link hero-link-secondary" href="#home-profile-name">认识作者</a>
        </div>
      </div>
      <HeroGallery />
    </div>
    {latest && <div class="cover-colophon"><span>最近更新</span><a href={base + '/posts/' + latest.id + '/'}>{latest.data.title}</a><span>文 / {authorById.get(latest.data.author.id)?.data.name}</span><span>{formatDate(latest.data.date)}</span></div>}
  </section>

  {founder && (
    <section class="home-profile" aria-labelledby="home-profile-name" data-reveal="image">
      <div class="home-profile-visual">
        {founder.data.cover && <img class="home-profile-cover" src={base + '/' + founder.data.cover.replace(/^\/+/, '')} width={founder.data.coverWidth} height={founder.data.coverHeight} alt={founder.data.coverAlt || ''} loading="lazy" decoding="async" />}
        <span class="home-profile-portrait">
          {founder.data.portrait ? <img src={base + '/' + founder.data.portrait.replace(/^\/+/, '')} width={founder.data.portraitWidth} height={founder.data.portraitHeight} alt={founder.data.portraitAlt || founder.data.name + '选用的头像'} loading="lazy" decoding="async" /> : <span aria-hidden="true">{founder.data.name.slice(0, 1)}</span>}
        </span>
      </div>
      <div class="home-profile-copy">
        <div class="home-profile-identity">
          <p class="home-profile-label">关于作者</p>
          <h2 id="home-profile-name">{founder.data.name}</h2>
          <ProfileMeta location={founder.data.location} displayDate={founder.data.displayDate} />
        </div>
        <div class="home-profile-about">
          <h3>About</h3>
          <p class="profile-greeting" lang="en" translate="no">{founder.data.bio || 'Hi! I\'m GINLANG.'}</p>
          {founder.data.quote && <ProfileQuote quote={founder.data.quote} founder />}
          <a href={base + '/about/'}>更多关于我</a>
        </div>
      </div>
    </section>
  )}

  <div class="home-content">
    <section class="selection-section" aria-labelledby="latest-title" data-reveal="ink">
      <div class="section-heading">
        <div class="section-heading-main">
          <p class="section-kicker">最近写的</p>
          <h2 id="latest-title">从这些文章开始</h2>
        </div>
        <div class="heading-actions">
          <button class="random-post" type="button" data-random-post data-post-urls={JSON.stringify(postUrls)} aria-label="随机打开一篇文章" hidden>随机翻一页</button>
          <a class="quiet-link" href={base + '/writing/'}>查看全部文章</a>
        </div>
      </div>

      {latest ? (
        <div class="selection-grid">
          <article class="featured-post">
            <div class="featured-topline"><span>{categoryLabel(latest.data.category)}</span><time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time></div>
            <h3><a href={base + '/posts/' + latest.id + '/'}>{latest.data.title}</a></h3>
            <p>{featuredExcerpt}</p>
            <div class="featured-meta"><span>文 / {authorById.get(latest.data.author.id)?.data.name}</span><span class="featured-reading-hint" aria-hidden="true">点开阅读</span></div>
          </article>
          {earlierPosts.length > 0 && <div class="selection-side" data-reveal="stagger">{earlierPosts.map((post) => <article class="selection-brief"><div class="selection-brief-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>{categoryLabel(post.data.category)}</span></div><h3><a href={base + '/posts/' + post.id + '/'}>{post.data.title}</a></h3><p>{post.data.excerpt}</p><a class="selection-brief-author" href={base + '/authors/' + post.data.author.id + '/'}>{authorById.get(post.data.author.id)?.data.name}</a></article>)}</div>}
        </div>
      ) : <p class="empty-note">第一篇文章还没有发布。</p>}
    </section>

    <section class="home-people" aria-labelledby="home-people-title" data-reveal="list">
      <div class="section-heading"><div class="section-heading-main"><h2 id="home-people-title">客席作者</h2></div>{guests.length > 0 && <a class="quiet-link" href={base + '/authors/'}>认识全部作者</a>}</div>
      {guests.length ? <div class="home-guest-list">{guests.slice(0, 3).map((author) => <article class="home-guest"><span class="person-initial" aria-hidden="true">{author.data.name.slice(0, 1)}</span><div><span>客席作者</span><h3><a href={base + '/authors/' + author.id + '/'}>{author.data.name}</a></h3><p>{author.data.tagline}</p></div></article>)}</div> : <div class="home-guest-empty"><p>朋友的介绍与作品，会在征得同意后陆续放在这里。</p><a class="quiet-link" href={base + '/contribute/'}>参与写作</a></div>}
    </section>

    {topics.length > 0 && <section class="home-topics" aria-labelledby="home-topics-title"><div class="section-heading"><h2 id="home-topics-title">主题选集</h2><a class="quiet-link" href={base + '/topics/'}>全部专题</a></div><div class="home-topic-list">{topics.slice(0, 2).map((topic) => <a href={base + '/topics/' + topic.id + '/'}><span>专题</span><h3>{topic.data.title}</h3><p>{topic.data.introduction}</p></a>)}</div></section>}

    <div class="home-whisper" data-reveal="quote"><MarginWhisper theme="home" /></div>

    <div data-reveal="ink"><DailyNote /></div>
    <p class="last-read-note" data-last-read hidden></p>
    <p class="desk-note">读到想留下的文章，写下还没写完的句子。<a href={base + '/desk/'}>打开我的书桌</a></p>

    <section class="landscape-section" aria-labelledby="landscape-title" data-landscape data-reveal="image">
      <div class="landscape-topline">
        <div>
          <h2 id="landscape-title">换一扇窗</h2>
        </div>
      </div>
      <div class="landscape-frame">
        {landscapes.map((scene, index) => (
          <img
            class:list={['landscape-image', { 'is-active': index === 0 }]}
            src={base + '/' + scene.file}
            width={scene.width}
            height={scene.height}
            alt={scene.alt}
            aria-hidden={index !== 0}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
      <div class="landscape-bottomline">
        <p data-landscape-caption aria-live="polite">{landscapes[0].caption}</p>
        <div class="landscape-controls" role="group" aria-label="切换窗外风景">
          {landscapes.map((scene, index) => (
            <button type="button" data-landscape-choice={index} data-landscape-caption={scene.caption} aria-pressed={index === 0}>{scene.label}</button>
          ))}
        </div>
      </div>
    </section>

    <section class="category-shelf" aria-labelledby="category-title" data-reveal="list">
      <div class="section-heading">
        <div class="section-heading-main">
          <h2 id="category-title">挑一类慢慢读</h2>
        </div>
      </div>
      <ol class="category-list" data-reveal="stagger">
        {categories.map((category) => (
          <li class="category-row">
            <a href={base + '/category/' + category.slug + '/'}>
              <span class="category-label">{category.label}</span>
              <span class="category-desc">{category.description}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

  </div>
</SiteLayout>

<script>
  const homeBase = import.meta.env.BASE_URL.replace(/\/$/, '');

  function initLastRead() {
    const note = document.querySelector<HTMLElement>('[data-last-read]:not([data-last-ready])');
    if (!note) return;
    note.dataset.lastReady = 'true';
    let raw = '';
    try {
      raw = localStorage.getItem('ginlang-last-read') || '';
    } catch {
      return; // Without storage the line simply stays hidden.
    }
    if (!raw) return;
    try {
      const saved = JSON.parse(raw);
      if (!saved || typeof saved.id !== 'string' || typeof saved.title !== 'string' || !saved.title) return;
      const link = document.createElement('a');
      link.href = homeBase + '/posts/' + encodeURIComponent(saved.id) + '/';
      link.textContent = '《' + saved.title + '》';
      note.textContent = '上次读到';
      note.append(link);
      note.hidden = false;
    } catch {
      // A malformed record is ignored rather than shown.
    }
  }

  function initRandomPost() {
    const button = document.querySelector<HTMLButtonElement>('[data-random-post]');
    if (!button || button.dataset.ready === 'true') return;
    let urls: string[] = [];
    try {
      urls = JSON.parse(button.dataset.postUrls ?? '[]');
    } catch {
      return;
    }
    if (!urls.length) return;
    button.dataset.ready = 'true';
    button.hidden = false;
    button.addEventListener('click', () => {
      const target = urls[Math.floor(Math.random() * urls.length)];
      if (target) window.location.assign(target);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initLastRead();
      initRandomPost();
    }, { once: true });
  } else {
    initLastRead();
    initRandomPost();
  }
  document.addEventListener('astro:page-load', () => {
    initLastRead();
    initRandomPost();
  });

  function initLandscape() {
    const gallery = document.querySelector<HTMLElement>('[data-landscape]:not([data-landscape-ready])');
    if (!gallery) return;
    const images = [...gallery.querySelectorAll<HTMLImageElement>('.landscape-image')];
    const buttons = [...gallery.querySelectorAll<HTMLButtonElement>('[data-landscape-choice]')];
    const caption = gallery.querySelector<HTMLElement>('[data-landscape-caption]');
    gallery.dataset.landscapeReady = 'true';
    buttons.forEach((button, index) => button.addEventListener('click', () => {
      images.forEach((image, imageIndex) => {
        const active = imageIndex === index;
        image.classList.toggle('is-active', active);
        image.setAttribute('aria-hidden', String(!active));
      });
      buttons.forEach((item, buttonIndex) => item.setAttribute('aria-pressed', String(buttonIndex === index)));
      if (caption) caption.textContent = button.dataset.landscapeCaption ?? '';
    }));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLandscape, { once: true });
  } else {
    initLandscape();
  }
  document.addEventListener('astro:page-load', initLandscape);
</script>
