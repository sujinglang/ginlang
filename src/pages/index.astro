---
import HeroGallery from '../components/HeroGallery.astro';
import DailyNote from '../components/DailyNote.astro';
import MarginWhisper from '../components/MarginWhisper.astro';
import ProfileMeta from '../components/ProfileMeta.astro';
import ProfileQuote from '../components/ProfileQuote.astro';
import SectionDivider from '../components/SectionDivider.astro';
import ResponsiveArt from '../components/ResponsiveArt.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { categories, categoryLabel } from '../lib/categories';
import { formatDate } from '../lib/date';
import { loadEditorialContent } from '../lib/content';
import { hasPublicAuthor } from '../lib/postVisibility';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { publishedPosts: posts, authors, authorById, founder } = await loadEditorialContent();
const guests = authors.filter((author) => author.data.role === 'guest' && author.data.featured).sort((a, b) => a.data.order - b.data.order);
const latest = posts[0];
// Show as much as the home can hold: the featured post plus up to five briefs.
const earlierPosts = posts.slice(1, 6);
const postUrls = posts.map((post) => base + '/posts/' + post.id + '/');
const landscapes = [
  { label: '海边', caption: '海边 · 清晨', file: 'sea-morning-animated.webp', width: 1400, height: 788, alt: '手绘的浅蓝海岸与清晨天空' },
  { label: '林间', caption: '林间 · 流水', file: 'forest-waterfall-animated.webp', width: 1400, height: 933, alt: '手绘的林间瀑布与浅色水潭' },
  { label: '街角', caption: '街角 · 一弯月', file: 'diary-moon-animated.webp', width: 720, height: 720, alt: '手绘的明亮街道与浅蓝天空中的弯月' },
];
---

<SiteLayout description="GINLANG 的个人博客。记录随笔、日记和读书时的想法。">
  <section class="home-intro" aria-labelledby="home-title">
    <div class="hero-kicker">
      <span>个人博客</span>
      <span>2026 · GINLANG</span>
    </div>
    <div class="home-hero">
      <div>
        <h1 id="home-title" class="cover-poem"><span class="hero-line">吹箫凌极浦，</span><span class="hero-line">日暮送夫君</span><span class="hero-line">湖上一回首，</span><span class="hero-line">青山卷白云</span></h1>
        <p class="intro-note">我是 GINLANG。这里放我写的随笔、日记和读书笔记，偶尔也会邀请朋友来写。</p>
        <div class="hero-links">
          <a class="hero-link" href="#latest-title">开始阅读</a>
          <a class="hero-link hero-link-secondary" href="#home-profile-name">认识作者</a>
        </div>
      </div>
      <HeroGallery />
    </div>
    {latest && <div class="cover-colophon"><span>最近更新</span><a href={base + '/posts/' + latest.id + '/'}>{latest.data.title}</a>{hasPublicAuthor(latest) && <span>文 / {authorById.get(latest.data.author.id)?.data.name}</span>}<span>{formatDate(latest.data.date)}</span></div>}
  </section>

  {founder && (
    <>
    <SectionDivider />
    <section class="home-profile home-section" aria-labelledby="home-profile-name" data-reveal="image">
      <div class="home-profile-visual">
        {founder.data.cover && <ResponsiveArt class="home-profile-cover" src={founder.data.cover} width={founder.data.coverWidth} height={founder.data.coverHeight} alt={founder.data.coverAlt || ''} />}
        <span class="home-profile-portrait">
          {founder.data.portrait ? <ResponsiveArt src={founder.data.portrait} sizes="172px" width={founder.data.portraitWidth} height={founder.data.portraitHeight} alt={founder.data.portraitAlt || founder.data.name + '选用的头像'} /> : <span aria-hidden="true">{founder.data.name.slice(0, 1)}</span>}
        </span>
      </div>
      <div class="home-profile-copy">
        <div class="home-profile-identity">
          <p class="home-profile-label">关于作者</p>
          <h2 id="home-profile-name">{founder.data.name}</h2>
          <ProfileMeta location={founder.data.location} displayDate={founder.data.displayDate} />
        </div>
        <div class="home-profile-about">
          <h3>About</h3>
          <p class="profile-greeting" lang="en" translate="no">{founder.data.bio || 'Hi! I\'m GINLANG.'}</p>
          {founder.data.quote && <ProfileQuote quote={founder.data.quote} quoteEnglish={founder.data.quoteEnglish} />}
          <a href={base + '/about/'}>更多关于我</a>
        </div>
      </div>
    </section>
    </>
  )}

  <div class="home-content">
    <SectionDivider art="landscape" />
    <section class="selection-section home-section" aria-labelledby="latest-title" data-reveal="ink">
      <div class="section-heading">
        <div class="section-heading-main">
          <p class="section-kicker">最近写的</p>
          <h2 id="latest-title">从这些文章开始</h2>
        </div>
        <div class="heading-actions">
          <button class="random-post" type="button" data-random-post data-post-urls={JSON.stringify(postUrls)} aria-label="随机打开一篇文章" hidden>随机翻一页</button>
          <a class="quiet-link" href={base + '/writing/'}>查看全部文章</a>
        </div>
      </div>

      {latest ? (
        <div class="selection-grid">
          <article class="featured-post">
            <div class="selection-post-meta">
              <time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time>
              <span>{categoryLabel(latest.data.category)}</span>
              {hasPublicAuthor(latest) && <a class="selection-brief-author selection-post-author" href={base + '/authors/' + latest.data.author.id + '/'}>{authorById.get(latest.data.author.id)?.data.name}</a>}
            </div>
            <h3><a href={base + '/posts/' + latest.id + '/'}>{latest.data.title}</a></h3>
            <p>{latest.data.excerpt}</p>
          </article>
          {earlierPosts.length > 0 && (
            <div class="selection-side" data-reveal="stagger">
              {earlierPosts.map((post) => (
                <article class="selection-brief">
                  <div class="selection-post-meta">
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                    <span>{categoryLabel(post.data.category)}</span>
                    {hasPublicAuthor(post) && <a class="selection-brief-author selection-post-author" href={base + '/authors/' + post.data.author.id + '/'}>{authorById.get(post.data.author.id)?.data.name}</a>}
                  </div>
                  <h3><a href={base + '/posts/' + post.id + '/'}>{post.data.title}</a></h3>
                  <p>{post.data.excerpt}</p>
                </article>
              ))}
            </div>
          )}
        </div>
      ) : <p class="empty-note">第一篇文章还没有发布。</p>}
    </section>

    <SectionDivider />
    <section class="home-people home-section" aria-labelledby="home-people-title" data-reveal="list">
      {guests.length > 0 && <div class="section-heading"><div class="section-heading-main"><h2 id="home-people-title">客席作者</h2></div><a class="quiet-link" href={base + '/authors/'}>认识全部作者</a></div>}
      {guests.length ? <div class="home-guest-list">{guests.slice(0, 3).map((author) => <article class="home-guest"><span class="home-guest-portrait">{author.data.portrait ? <ResponsiveArt src={author.data.portrait} sizes="72px" width={author.data.portraitWidth} height={author.data.portraitHeight} alt="" loading="lazy" /> : <span class="person-initial" aria-hidden="true">{author.data.name.slice(0, 1)}</span>}</span><div><span>客席作者</span><h3><a href={base + '/authors/' + author.id + '/'}>{author.data.name}</a></h3><p>{author.data.tagline}</p></div></article>)}</div> : <a class="home-guest-invitation" href={base + '/contribute/'}><h2 id="home-people-title">客席作者</h2><span>参与写作</span><p>朋友的介绍与作品，会在征得同意后陆续放在这里。</p></a>}
    </section>

    <SectionDivider />
    <div class="home-whisper home-section" data-reveal="quote"><MarginWhisper theme="home" /></div>

    <SectionDivider art="study" />
    <div class="home-note home-section" data-reveal="ink"><DailyNote /></div>
    <p class="last-read-note" data-last-read hidden></p>
    <p class="desk-note">读到想留下的文章，写下还没写完的句子。<a href={base + '/desk/'}>打开我的书桌</a></p>

    <SectionDivider />
    <section class="landscape-section home-section" aria-labelledby="landscape-title" data-landscape data-reveal="image">
      <div class="landscape-topline">
        <div>
          <h2 id="landscape-title">换一扇窗</h2>
        </div>
      </div>
      <div class="landscape-frame">
        {landscapes.map((scene, index) => (
          <img
            class:list={['landscape-image', { 'is-active': index === 0 }]}
            src={base + '/' + scene.file}
            srcset={scene.width > 800 ? `${base}/${scene.file.replace('.webp', '-480w.webp')} 480w, ${base}/${scene.file.replace('.webp', '-800w.webp')} 800w, ${base}/${scene.file} ${scene.width}w` : `${base}/${scene.file.replace('.webp', '-480w.webp')} 480w, ${base}/${scene.file} ${scene.width}w`}
            sizes="(max-width: 680px) 90vw, (max-width: 1244px) 92vw, 1180px"
            width={scene.width}
            height={scene.height}
            alt={scene.alt}
            aria-hidden={index !== 0}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
      <div class="landscape-bottomline">
        <p data-landscape-caption aria-live="polite">{landscapes[0].caption}</p>
        <div class="landscape-controls" role="group" aria-label="切换窗外风景">
          {landscapes.map((scene, index) => (
            <button type="button" data-landscape-choice={index} data-landscape-caption={scene.caption} aria-pressed={index === 0}>{scene.label}</button>
          ))}
        </div>
      </div>
    </section>

    <SectionDivider art="reeds" />
    <section class="category-shelf home-section" aria-labelledby="category-title" data-reveal="list">
      <div class="section-heading">
        <div class="section-heading-main">
          <h2 id="category-title">挑一类慢慢读</h2>
        </div>
      </div>
      <ol class="category-list" data-reveal="stagger">
        {categories.map((category) => (
          <li class="category-row">
            <a href={base + '/category/' + category.slug + '/'}>
              <span class="category-label">{category.label}</span>
              <span class="category-desc">{category.description}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

  </div>
</SiteLayout>

<script>
  const homeBase = import.meta.env.BASE_URL.replace(/\/$/, '');

  function initLastRead() {
    const note = document.querySelector<HTMLElement>('[data-last-read]:not([data-last-ready])');
    if (!note) return;
    note.dataset.lastReady = 'true';
    let raw = '';
    try {
      raw = localStorage.getItem('ginlang-last-read') || '';
    } catch {
      return; // Without storage the line simply stays hidden.
    }
    if (!raw) return;
    try {
      const saved = JSON.parse(raw);
      if (!saved || typeof saved.id !== 'string' || typeof saved.title !== 'string' || !saved.title) return;
      const link = document.createElement('a');
      link.href = homeBase + '/posts/' + encodeURIComponent(saved.id) + '/';
      link.textContent = '《' + saved.title + '》';
      note.textContent = '上次读到';
      note.append(link);
      note.hidden = false;
    } catch {
      // A malformed record is ignored rather than shown.
    }
  }

  function initRandomPost() {
    const button = document.querySelector<HTMLButtonElement>('[data-random-post]');
    if (!button || button.dataset.ready === 'true') return;
    let urls: string[] = [];
    try {
      urls = JSON.parse(button.dataset.postUrls ?? '[]');
    } catch {
      return;
    }
    if (!urls.length) return;
    button.dataset.ready = 'true';
    button.hidden = false;
    button.addEventListener('click', () => {
      const target = urls[Math.floor(Math.random() * urls.length)];
      if (target) window.location.assign(target);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initLastRead();
      initRandomPost();
    }, { once: true });
  } else {
    initLastRead();
    initRandomPost();
  }
  document.addEventListener('astro:page-load', () => {
    initLastRead();
    initRandomPost();
  });

  function initLandscape() {
    const gallery = document.querySelector<HTMLElement>('[data-landscape]:not([data-landscape-ready])');
    if (!gallery) return;
    const images = [...gallery.querySelectorAll<HTMLImageElement>('.landscape-image')];
    const buttons = [...gallery.querySelectorAll<HTMLButtonElement>('[data-landscape-choice]')];
    const caption = gallery.querySelector<HTMLElement>('[data-landscape-caption]');
    gallery.dataset.landscapeReady = 'true';
    buttons.forEach((button, index) => button.addEventListener('click', () => {
      images.forEach((image, imageIndex) => {
        const active = imageIndex === index;
        image.classList.toggle('is-active', active);
        image.setAttribute('aria-hidden', String(!active));
      });
      buttons.forEach((item, buttonIndex) => item.setAttribute('aria-pressed', String(buttonIndex === index)));
      if (caption) caption.textContent = button.dataset.landscapeCaption ?? '';
    }));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLandscape, { once: true });
  } else {
    initLandscape();
  }
  document.addEventListener('astro:page-load', initLandscape);
</script>
