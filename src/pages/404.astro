---
import MarginWhisper from '../components/MarginWhisper.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<SiteLayout title="没有找到这一页">
  <section class="not-found">
    <p class="eyebrow">404 · 走岔了一页</p>
    <h1>这里暂时没有文字。</h1>
    <MarginWhisper theme="notFound" />
    <a class="back-link" href={base + '/'}>回到首页 →</a>
  </section>
</SiteLayout>
