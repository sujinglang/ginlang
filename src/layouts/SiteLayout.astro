---
import '../styles/global.css';
import marckScriptFont from '../assets/fonts/marck-script-latin.woff2?url';
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import { formatDate } from '../lib/date';
import { getHomeShareCard } from '../lib/shareCard';
import AmbientMusic from '../components/AmbientMusic.astro';

// 2026-11-08 用户要求：「回到页首」先封存：代码、样式、交互脚本都保留，只是不渲染。
// 想恢复把这里改成 true 即可。
const showToTop = false;

interface Props {
  title?: string;
  description?: string;
  articlePage?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  publishedTime?: string;
  noIndex?: boolean;
}

const {
  title = 'GINLANG',
  description = '随笔、日记、书摘与短句，给经过的日子留一页。',
  articlePage = false,
  ogImage,
  ogImageAlt,
  publishedTime,
  noIndex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site?.toString() ?? 'https://ginlang.vip';
const canonicalUrl = new URL(Astro.url.pathname.endsWith('/404/') ? base + '/404.html' : Astro.url.pathname, siteUrl).toString();
const homeUrl = new URL(base + '/', siteUrl).toString();
const homeCard = ogImage ? undefined : await getHomeShareCard();
const socialImage = new URL(base + (ogImage ?? homeCard!.url), siteUrl).toString();
const socialImageAlt = ogImageAlt ?? homeCard?.alt ?? `${title}的分享封面`;
const pageTitle = title.includes('GINLANG') ? title : title + ' · GINLANG';
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const navItems = [
  { label: '首页', hint: '回到首页', href: base + '/' },
  { label: '文章', hint: '挑一篇来读', href: base + '/writing/' },
  { label: '客席作者', hint: '认识一起写的人', href: base + '/authors/' },
  { label: '关于', hint: '了解 GINLANG', href: base + '/about/' },
];
const isCurrent = (href: string) => {
  const target = href.replace(/\/+$/, '') || '/';
  if (target === base) return currentPath === target;
  if (target === base + '/writing' && (currentPath.startsWith(base + '/category/') || currentPath.startsWith(base + '/posts/'))) return true;
  return currentPath === target || currentPath.startsWith(target + '/');
};
const year = new Date().getFullYear();
const latestPost = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)[0];
const latestDateLabel = latestPost ? formatDate(latestPost.data.date) : undefined;
const webSiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'GINLANG',
  url: new URL(base + '/', siteUrl).toString(),
  inLanguage: 'zh-CN',
  description,
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="zh-CN" prefix="og: https://ogp.me/ns# article: https://ogp.me/ns/article#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" id="theme-color" content="#f5f2eb" />
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={base + '/favicon.svg'} />
    {(currentPath === base || currentPath === base + '/about') && <link rel="preload" href={marckScriptFont} as="font" type="font/woff2" crossorigin />}
    <link rel="alternate" type="application/rss+xml" title="GINLANG RSS" href={base + '/rss.xml'} />
    <meta property="og:site_name" content="GINLANG" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={articlePage ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:locale" content="zh_CN" />
    {articlePage && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={webSiteSchema}></script>
    <script is:inline>
      (() => {
        const defaults = { theme: 'light', textSize: 'normal', font: 'serif', width: 'comfortable' };
        const valid = {
          theme: ['system', 'light', 'dark'],
          textSize: ['small', 'normal', 'large'],
          font: ['serif', 'sans'],
          width: ['narrow', 'comfortable', 'wide'],
        };
        let preferences = { ...defaults };

        try {
          const saved = JSON.parse(localStorage.getItem('ginlang-preferences') || 'null');
          if (saved && typeof saved === 'object') {
            for (const key of Object.keys(defaults)) {
              if (valid[key].includes(saved[key])) preferences[key] = saved[key];
            }
          } else {
            const legacyTheme = localStorage.getItem('ginlang-theme');
            if (legacyTheme === 'light' || legacyTheme === 'dark') preferences.theme = legacyTheme;
          }
        } catch {
          // Keep the defaults when browser storage is unavailable or malformed.
        }

        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.themeMode = preferences.theme;
        document.documentElement.dataset.theme =
          preferences.theme === 'system' ? (prefersDark ? 'dark' : 'light') : preferences.theme;
        document.documentElement.dataset.textSize = preferences.textSize;
        document.documentElement.dataset.font = preferences.font;
        document.documentElement.dataset.readingWidth = preferences.width;
        const themeColor = document.querySelector('meta[name="theme-color"]');
        if (themeColor) themeColor.content = document.documentElement.dataset.theme === 'dark' ? '#20221f' : '#f5f2eb';
      })();
    </script>
    <!-- 单页路由：站内链接由这里接管，换页不再整份重载。音乐用 transition:persist 跨页不断。 -->
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="brand-block">
          <a class="wordmark" href={base + '/'} aria-label="GINLANG 首页">
            <span translate="no">GINLANG</span><span class="wordmark-flower" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M5.6 18.4L18.4 5.6" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" /></svg></span>
          </a>
          <span class="brand-note">PERSONAL BLOG</span>
        </div>

        <button class="menu-toggle" type="button" data-menu-toggle aria-controls="primary-nav" aria-expanded="false">
          <span class="menu-toggle-copy"><strong>目录</strong><small aria-hidden="true">文章 · 作者 · 关于</small></span>
          <span class="menu-toggle-mark" aria-hidden="true"></span>
        </button>
        <nav class="primary-nav" id="primary-nav" aria-label="主导航">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}><span>{item.label}</span><small>{item.hint}</small></a>
          ))}
        </nav>

        <div class="header-tools" aria-label="阅读工具">
          <button class="tool-button" type="button" data-share-site aria-label="分享 GINLANG 网站" aria-haspopup="dialog" aria-controls="share-dialog">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 4h7v7M20 4l-9 9"></path><path d="M19 13v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5"></path></svg>
          </button>
          <button class="tool-button" id="search-open" type="button" aria-label="搜索文章" aria-haspopup="dialog" aria-controls="search-dialog">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.6"></circle><path d="m16 16 4.3 4.3"></path></svg>
          </button>
          <button class="tool-button settings-open" id="settings-open" type="button" aria-label="阅读设置" aria-haspopup="dialog" aria-controls="reading-settings">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8.3a3.7 3.7 0 1 0 0 7.4 3.7 3.7 0 0 0 0-7.4Z"></path><path d="m19.1 13.5 1.1.9-1.6 2.8-1.4-.5a7.8 7.8 0 0 1-1.5.9l-.3 1.5h-3.2l-.3-1.5a7.8 7.8 0 0 1-1.5-.9l-1.4.5-1.6-2.8 1.1-.9a7.7 7.7 0 0 1 0-1.8l-1.1-.9 1.6-2.8 1.4.5a7.8 7.8 0 0 1 1.5-.9l.3-1.5h3.2l.3 1.5a7.8 7.8 0 0 1 1.5.9l1.4-.5 1.6 2.8-1.1.9a7.7 7.7 0 0 1 0 1.8Z"></path></svg>
          </button>
        </div>
      </header>

      {articlePage && (
        <div class="reading-progress" aria-hidden="true"><span id="reading-progress-fill"></span></div>
      )}

      <main id="main-content" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-main">
          <div>
            <a class="footer-wordmark" href={base + '/'}>GINLANG <span aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M5.6 18.4L18.4 5.6" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" /></svg></span></a>
            <p>这里的文章，还会慢慢增加。</p>
          </div>
          <div class="footer-actions">
            <a class="rss-link" href={base + '/contribute/'}>参与写作</a>
            <button class="rss-link share-link" type="button" data-share-site>分享网站</button>
          </div>
        </div>
        <nav class="footer-nav" aria-label="页脚导航">{navItems.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}><span>{item.label}</span><small>{item.hint}</small></a>)}</nav>
        <div class="footer-bottom">
          <span>© {year} GINLANG</span>
          {latestDateLabel && <span>最近发表 · {latestDateLabel}</span>}
          <span>作品署名与权利归各自作者；转载前请征得作者同意。</span>
          <a href="#main-content">回到顶部 ↑</a>
        </div>
        <div class="footer-visit" hidden aria-label="本站累计访问人次">
          <span>访问人次</span><strong id="busuanzi_value_site_pv">—</strong><small>由不蒜子统计</small>
        </div>
      </footer>
    </div>

    <AmbientMusic />

    <script is:inline>
      (() => {
        // 不蒜子 3.6.9 的脚本按 id 回填数字，id 必须是 busuanzi_value_site_pv，写错就永远等不到值。
        const pv = document.getElementById('busuanzi_value_site_pv');
        if (!pv) return;
        // 统计是第三方的，失败时不能让「—」留在页脚里冒充数据：
        // 整块默认隐藏，只有真拿到数字才显示，脚本报错或超时就继续藏着。
        const panel = pv.closest('.footer-visit');
        const reveal = (value) => {
          const text = String(value || '').trim();
          if (!text || text === '—') return false;
          pv.textContent = text;
          if (panel) panel.hidden = false;
          return true;
        };
        if (['localhost', '127.0.0.1'].includes(location.hostname)) return;
        // Count at most once per tab session, so refreshing the page does not inflate the number.
        // The last known figure is cached and shown on every page of the visit.
        let cached = '';
        try { cached = localStorage.getItem('ginlang-visit-pv') || ''; } catch { /* Storage is optional. */ }
        if (cached) reveal(cached);
        let counted = '';
        try { counted = sessionStorage.getItem('ginlang-visit-counted') || ''; } catch { /* Storage is optional. */ }
        if (counted) return;
        try { sessionStorage.setItem('ginlang-visit-counted', '1'); } catch { /* Storage is optional. */ }
        const counter = document.createElement('script');
        counter.src = 'https://cdn.busuanzi.cc/busuanzi/3.6.9/busuanzi.min.js';
        counter.defer = true;
        counter.addEventListener('error', () => { if (!cached) panel && (panel.hidden = true); });
        document.body.append(counter);
        const watch = new MutationObserver(() => {
          const value = pv.textContent.trim();
          if (value && value !== '—' && value !== cached) {
            try { localStorage.setItem('ginlang-visit-pv', value); } catch { /* Storage is optional. */ }
            reveal(value);
            watch.disconnect();
          }
        });
        watch.observe(pv, { childList: true, characterData: true, subtree: true });
        // 八秒还没数字就先收起整块（但不停止观察：接口慢一点回来仍能补上）。
        window.setTimeout(() => {
          const value = pv.textContent.trim();
          if ((!value || value === '—') && panel) panel.hidden = true;
        }, 8000);
      })();
    </script>

    {showToTop && <button class="to-top" type="button" data-to-top hidden aria-label="回到页首">回到页首 <span aria-hidden="true">↑</span></button>}

    <dialog class="utility-dialog share-dialog" id="share-dialog" aria-labelledby="share-title" data-share-url={homeUrl}>
      <div class="dialog-topline">
        <div>
          <p class="dialog-kicker">PASS THE LETTER ALONG</p>
          <h2 id="share-title">把我的博客分享给朋友</h2>
        </div>
        <button class="dialog-close" type="button" data-dialog-close aria-label="关闭分享窗口">×</button>
      </div>
      <p class="share-intro">这是网站的公开地址。朋友点开链接就能阅读，无需登录。</p>
      <label class="share-label" for="share-url">网站地址</label>
      <div class="share-url-row">
        <input id="share-url" type="text" readonly value={homeUrl} />
        <button class="solid-button" id="share-copy" type="button">复制链接</button>
      </div>
      <button class="text-button share-native" id="share-native" type="button" hidden>使用系统分享</button>
      <p class="share-intro share-moments-note">发朋友圈时，请先在微信里打开网页，再点微信窗口右上角「…」→「分享到朋友圈」。单把网址粘进配文栏，会作为普通文字发布。</p>
      <p class="share-status" id="share-status" aria-live="polite">复制后就可以发送给朋友。</p>
    </dialog>

    <dialog class="utility-dialog search-dialog" id="search-dialog" aria-labelledby="search-title" data-index-url={base + '/search-index.json'}>
      <div class="dialog-topline">
        <div>
          <p class="dialog-kicker">FIND A LINE</p>
          <h2 id="search-title">找一篇文章</h2>
        </div>
        <button class="dialog-close" type="button" data-dialog-close aria-label="关闭搜索">×</button>
      </div>
      <label class="sr-only" for="search-input">搜索文章正文、标题、摘要、作者、分类和标签</label>
      <input class="search-input" id="search-input" type="search" name="query" placeholder="输入文章标题或关键词…" autocomplete="off" />
      <p class="search-status" id="search-status" aria-live="polite">输入关键词，慢慢找。</p>
      <ol class="search-results" id="search-results"></ol>
      <div class="dialog-foot"><span>正文 · 标题 · 作者 · 分类 · 标签 · <kbd>↑</kbd><kbd>↓</kbd> 选择</span><kbd>ESC</kbd></div>
    </dialog>

    <dialog class="utility-dialog settings-dialog" id="reading-settings" aria-labelledby="settings-title">
      <div class="dialog-topline">
        <div>
          <p class="dialog-kicker">YOUR READING ROOM</p>
          <h2 id="settings-title">阅读设置</h2>
        </div>
        <button class="dialog-close" type="button" data-dialog-close aria-label="关闭阅读设置">×</button>
      </div>
      <form id="settings-form">
        <fieldset class="setting-group">
          <legend>页面主题</legend>
          <div class="setting-options">
            <label><input type="radio" name="theme" value="system" /><span>跟随系统</span></label>
            <label><input type="radio" name="theme" value="light" /><span>浅色纸页</span></label>
            <label><input type="radio" name="theme" value="dark" /><span>夜间阅读</span></label>
          </div>
        </fieldset>
        <fieldset class="setting-group">
          <legend>阅读字号</legend>
          <div class="setting-options">
            <label><input type="radio" name="textSize" value="small" /><span>小</span></label>
            <label><input type="radio" name="textSize" value="normal" /><span>标准</span></label>
            <label><input type="radio" name="textSize" value="large" /><span>大</span></label>
          </div>
        </fieldset>
        <fieldset class="setting-group">
          <legend>字体风格</legend>
          <div class="setting-options">
            <label><input type="radio" name="font" value="serif" /><span>衬线</span></label>
            <label><input type="radio" name="font" value="sans" /><span>黑体</span></label>
          </div>
        </fieldset>
        <fieldset class="setting-group">
          <legend>阅读宽度</legend>
          <div class="setting-options">
            <label><input type="radio" name="width" value="narrow" /><span>窄</span></label>
            <label><input type="radio" name="width" value="comfortable" /><span>适中</span></label>
            <label><input type="radio" name="width" value="wide" /><span>宽</span></label>
          </div>
        </fieldset>
      </form>
      <div class="settings-actions">
        <button class="text-button" id="settings-reset" type="button">恢复默认</button>
        <button class="solid-button" type="button" data-dialog-close>完成</button>
      </div>
      <p class="settings-note">偏好只保存在当前浏览器中。</p>
    </dialog>

    <script>
      type Preferences = {
        theme: 'system' | 'light' | 'dark';
        textSize: 'small' | 'normal' | 'large';
        font: 'serif' | 'sans';
        width: 'narrow' | 'comfortable' | 'wide';
      };

      const preferenceKey = 'ginlang-preferences';
      const defaults: Preferences = { theme: 'light', textSize: 'normal', font: 'serif', width: 'comfortable' };
      const root = document.documentElement;

      // 2026-11 单页路由（ClientRouter）改造，这一层要分两种东西看：
      //   1. 全站只注册一次的监听（滚动、快捷键、页面外点击）挂在 document / window 上，
      //      内部一律读下面的可变引用；换页时引用由 bindPage() 换成新节点。
      //   2. 每次换页都要重绑的元素监听（页头菜单、三个对话框、进度条）——换页后是新的 DOM，
      //      直接绑即可；用 pageGeneration 防止同一份 DOM 被绑两遍。
      // 以前这段是顶层直接 querySelector，换页后引用全指向被替换掉的旧节点，菜单/搜索/
      // 设置会一起失灵，这也是上一次单页路由回滚的原因。
      let headerEl: HTMLElement | null = null;
      let menuToggle: HTMLButtonElement | null = null;
      let menu: HTMLElement | null = null;
      let settingsDialog: HTMLDialogElement | null = null;
      let settingsForm: HTMLFormElement | null = null;
      let searchDialog: HTMLDialogElement | null = null;
      let searchInput: HTMLInputElement | null = null;
      let searchResults: HTMLOListElement | null = null;
      let searchStatus: HTMLParagraphElement | null = null;
      let shareDialog: HTMLDialogElement | null = null;
      let shareUrlInput: HTMLInputElement | null = null;
      let shareStatus: HTMLElement | null = null;
      let progressFill: HTMLElement | null = null;
      let progressArticle: HTMLElement | null = null;
      let toTopButton: HTMLButtonElement | null = null;
      let articleObserver: ResizeObserver | null = null;
      let pageGeneration = 0;
      let boundGeneration = -1;
      let scrollFrame = 0;

      // The inline head script has already restored saved choices before this module runs.
      // Start from those applied values so opening the dialog reflects the visible page.
      let preferences: Preferences = {
        theme: root.dataset.themeMode === 'system' || root.dataset.themeMode === 'dark' ? root.dataset.themeMode : 'light',
        textSize: root.dataset.textSize === 'small' || root.dataset.textSize === 'large' ? root.dataset.textSize : 'normal',
        font: root.dataset.font === 'sans' ? 'sans' : 'serif',
        width: root.dataset.readingWidth === 'narrow' || root.dataset.readingWidth === 'wide' ? root.dataset.readingWidth : 'comfortable',
      };

      function resolvedTheme(theme: Preferences['theme']) {
        if (theme !== 'system') return theme;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      function paintPreferences(save = false) {
        root.dataset.themeMode = preferences.theme;
        root.dataset.theme = resolvedTheme(preferences.theme);
        root.dataset.textSize = preferences.textSize;
        root.dataset.font = preferences.font;
        root.dataset.readingWidth = preferences.width;
        // 换页后 <head> 也换成了新文档的，theme-color 这个 meta 必须重新查一次。
        const themeColor = document.querySelector<HTMLMetaElement>('#theme-color');
        if (themeColor) themeColor.content = resolvedTheme(preferences.theme) === 'dark' ? '#20221f' : '#f5f2eb';
        if (save) {
          try {
            localStorage.setItem(preferenceKey, JSON.stringify(preferences));
          } catch {
            // Preferences still apply until the page is closed if storage is unavailable.
          }
        }
      }

      function syncSettingsForm() {
        settingsForm?.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((input) => {
          input.checked = input.value === preferences[input.name as keyof Preferences];
        });
      }

      function closeMenu(restoreFocus = false) {
        if (!menuToggle) return;
        menuToggle.setAttribute('aria-expanded', 'false');
        if (restoreFocus) menuToggle.focus();
      }

      type SearchItem = { title: string; excerpt: string; body: string; category: string; tags?: string[]; author?: string; date: string; url: string };
      let searchItemsPromise: Promise<SearchItem[]> | undefined;
      let searchRevision = 0;

      // 索引与已展开的搜索结果跟着模块活，换页不会重新下载一次 search-index.json。
      function getSearchItems() {
        // 索引地址写在对话框的 data-index-url 上；换页后对话框是新节点，所以每次现取。
        const indexUrl = searchDialog?.dataset?.indexUrl ?? '/search-index.json';
        searchItemsPromise ??= fetch(indexUrl)
          .then((response) => {
            if (!response.ok) throw new Error('Search index unavailable');
            return response.json() as Promise<SearchItem[]>;
          })
          .catch((error) => {
            searchItemsPromise = undefined;
            throw error;
          });
        return searchItemsPromise;
      }

      function highlighted(text: string, query: string) {
        const fragment = document.createDocumentFragment();
        if (!query) {
          fragment.append(text);
          return fragment;
        }
        const lower = text.toLocaleLowerCase();
        let index = 0;
        for (;;) {
          const found = lower.indexOf(query, index);
          if (found === -1) {
            fragment.append(text.slice(index));
            break;
          }
          if (found > index) fragment.append(text.slice(index, found));
          const mark = document.createElement('mark');
          mark.textContent = text.slice(found, found + query.length);
          fragment.append(mark);
          index = found + query.length;
        }
        return fragment;
      }

      function showSearchResult(item: SearchItem, query: string) {
        if (!searchResults) return;
        const row = document.createElement('li');
        const link = document.createElement('a');
        const meta = document.createElement('span');
        const title = document.createElement('strong');
        const excerpt = document.createElement('span');
        row.className = 'search-result';
        link.href = item.url;
        meta.className = 'search-result-meta';
        meta.textContent = [item.date, item.category, item.author].filter(Boolean).join('  ·  ');
        title.append(highlighted(item.title, query));
        const bodyIndex = item.body.toLocaleLowerCase().indexOf(query);
        const source = bodyIndex >= 0 && !item.excerpt.toLocaleLowerCase().includes(query)
          ? (bodyIndex > 42 ? '…' : '') + item.body.slice(Math.max(0, bodyIndex - 42), bodyIndex + query.length + 84) + (bodyIndex + query.length + 84 < item.body.length ? '…' : '')
          : item.excerpt;
        excerpt.append(highlighted(source, query));
        link.append(meta, title, excerpt);
        row.append(link);
        searchResults.append(row);
      }

      async function updateSearch() {
        if (!searchResults || !searchStatus || !searchInput) return;
        const revision = ++searchRevision;
        const query = searchInput.value.trim().toLocaleLowerCase();
        searchResults.replaceChildren();
        if (!query) {
          searchStatus.textContent = '输入关键词，慢慢找。';
          return;
        }
        searchStatus.textContent = '正在翻找…';
        let items: SearchItem[];
        try { items = await getSearchItems(); }
        catch {
          if (revision === searchRevision && searchDialog?.open) searchStatus.textContent = '文章索引加载失败，请重新搜索以重试。';
          return;
        }
        if (revision !== searchRevision || !searchDialog?.open) return;
        const matches = items.filter((item) =>
          (item.title + ' ' + item.excerpt + ' ' + item.category + ' ' + (item.tags ?? []).join(' ') + ' ' + (item.author ?? '') + ' ' + item.body).toLocaleLowerCase().includes(query),
        ).sort((a, b) => Number(b.title.toLocaleLowerCase().includes(query)) - Number(a.title.toLocaleLowerCase().includes(query))
          || Number(b.excerpt.toLocaleLowerCase().includes(query)) - Number(a.excerpt.toLocaleLowerCase().includes(query))).slice(0, 8);
        if (matches.length) {
          searchStatus.textContent = '找到这些相关的文章';
          matches.forEach((item) => showSearchResult(item, query));
        } else {
          searchStatus.textContent = items.length ? '没有找到相关文章。换个词试试。' : '暂无已发布文章。';
        }
      }

      function openSearch() {
        if (!searchDialog) return;
        if (!searchDialog.open) searchDialog.showModal();
        searchInput?.focus();
        // Warm the index while the reader is still thinking of a word.
        void getSearchItems().catch(() => { /* A query displays the error and can retry. */ });
      }

      // 单页路由下 history.state 由 ClientRouter 用来记滚动位置与来回方向。
      // replaceState 传 null 会把它抹掉，之后按「返回」时路由器会以为没有状态而直接放弃换页。
      function replaceQueryParam(key: string, value: string | null) {
        const url = new URL(window.location.href);
        if (value) url.searchParams.set(key, value);
        else url.searchParams.delete(key);
        window.history.replaceState(window.history.state, '', url);
      }

      function closeSearch() {
        const wasOpen = searchDialog?.open;
        if (wasOpen) searchDialog?.close();
        return wasOpen;
      }

      function fillSearchFromUrl() {
        const query = new URL(window.location.href).searchParams.get('q');
        if (!query || !searchInput || !searchDialog) return;
        searchInput.value = query;
        if (!searchDialog.open) searchDialog.showModal();
        void updateSearch();
      }

      function openShareDialog() {
        if (!shareDialog) return;
        if (!shareDialog.open) shareDialog.showModal();
        shareUrlInput?.focus();
        shareUrlInput?.select();
      }

      function scheduleScrollState() {
        if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateScrollState);
      }

      function updateScrollState() {
        scrollFrame = 0;
        if (progressFill && progressArticle) {
          const articleTop = window.scrollY + progressArticle.getBoundingClientRect().top;
          const scrollable = Math.max(1, progressArticle.scrollHeight - window.innerHeight);
          const progress = Math.min(1, Math.max(0, (window.scrollY - articleTop) / scrollable));
          progressFill.style.transform = 'scaleX(' + progress + ')';
        }
        if (toTopButton) {
          // Article pages already have a floating bookmark in the corner; sit above it.
          const artworkInView = window.innerWidth <= 680 && Array.from(
            document.querySelectorAll<HTMLElement>('.home-profile-visual, .hero-gallery, .landscape-frame'),
          ).some((artwork) => {
            const bounds = artwork.getBoundingClientRect();
            return bounds.top < window.innerHeight && bounds.bottom > 0;
          });
          // The footer has its own return link. Avoid covering the visit count.
          const footer = document.querySelector<HTMLElement>('.site-footer');
          const footerInView = footer ? footer.getBoundingClientRect().top < window.innerHeight : false;
          toTopButton.hidden = window.scrollY < 640 || artworkInView || footerInView;
        }
      }

      function bindPage() {
        headerEl = document.querySelector<HTMLElement>('.site-header');
        menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
        menu = document.querySelector<HTMLElement>('#primary-nav');
        if (headerEl && menuToggle && menu) {
          headerEl.dataset.menuReady = 'true';
          menuToggle.addEventListener('click', () => {
            menuToggle!.setAttribute('aria-expanded', String(menuToggle!.getAttribute('aria-expanded') !== 'true'));
          });
          menu.addEventListener('click', (event) => { if ((event.target as Element).closest('a')) closeMenu(); });
        }

        settingsDialog = document.querySelector<HTMLDialogElement>('#reading-settings');
        settingsForm = document.querySelector<HTMLFormElement>('#settings-form');
        document.querySelector('#settings-open')?.addEventListener('click', () => {
          syncSettingsForm();
          settingsDialog?.showModal();
        });
        settingsDialog?.addEventListener('click', (event) => {
          if (event.target === settingsDialog) settingsDialog.close();
        });
        settingsForm?.addEventListener('change', () => {
          const values = new FormData(settingsForm!);
          const theme = values.get('theme');
          const textSize = values.get('textSize');
          const font = values.get('font');
          const width = values.get('width');
          preferences = {
            theme: theme === 'light' || theme === 'dark' ? theme : 'system',
            textSize: textSize === 'small' || textSize === 'large' ? textSize : 'normal',
            font: font === 'sans' ? 'sans' : 'serif',
            width: width === 'narrow' || width === 'wide' ? width : 'comfortable',
          };
          paintPreferences(true);
        });
        document.querySelector('#settings-reset')?.addEventListener('click', () => {
          preferences = { ...defaults };
          syncSettingsForm();
          paintPreferences(true);
        });

        searchDialog = document.querySelector<HTMLDialogElement>('#search-dialog');
        searchInput = document.querySelector<HTMLInputElement>('#search-input');
        searchResults = document.querySelector<HTMLOListElement>('#search-results');
        searchStatus = document.querySelector<HTMLParagraphElement>('#search-status');
        document.querySelector('#search-open')?.addEventListener('click', openSearch);
        searchDialog?.addEventListener('click', (event) => {
          if (event.target === searchDialog) searchDialog.close();
        });
        searchDialog?.addEventListener('close', () => {
          if (searchInput) searchInput.value = '';
          replaceQueryParam('q', null);
          void updateSearch();
        });
        searchInput?.addEventListener('input', () => {
          if (!searchInput) return;
          replaceQueryParam('q', searchInput.value.trim() || null);
          void updateSearch();
        });
        searchInput?.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            event.preventDefault();
            event.stopPropagation();
            closeSearch();
            return;
          }
          if (event.key === 'ArrowDown') {
            const first = searchResults?.querySelector('a');
            if (first) {
              event.preventDefault();
              first.focus();
            }
          }
        });
        searchResults?.addEventListener('keydown', (event) => {
          if (!(event.target instanceof HTMLAnchorElement) || !searchResults) return;
          const links = [...searchResults.querySelectorAll('a')];
          const index = links.indexOf(event.target);
          if (index === -1) return;
          if (event.key === 'ArrowDown' && index < links.length - 1) {
            event.preventDefault();
            links[index + 1].focus();
          } else if (event.key === 'ArrowUp') {
            event.preventDefault();
            if (index > 0) links[index - 1].focus();
            else searchInput?.focus();
          }
        });

        shareDialog = document.querySelector<HTMLDialogElement>('#share-dialog');
        shareUrlInput = document.querySelector<HTMLInputElement>('#share-url');
        shareStatus = document.querySelector<HTMLElement>('#share-status');
        const nativeShareButton = document.querySelector<HTMLButtonElement>('#share-native');
        document.querySelectorAll<HTMLButtonElement>('[data-share-site]').forEach((button) => {
          button.addEventListener('click', openShareDialog);
        });
        if (nativeShareButton && typeof navigator.share === 'function') {
          nativeShareButton.hidden = false;
          nativeShareButton.addEventListener('click', async () => {
            const shareUrl = shareDialog?.dataset.shareUrl;
            if (!shareUrl) return;
            try {
              await navigator.share({ title: 'GINLANG', url: shareUrl });
              shareDialog?.close();
            } catch (error) {
              if (error instanceof DOMException && error.name === 'AbortError') return;
              if (shareStatus) shareStatus.textContent = '系统分享暂不可用，可以复制上方网址。';
            }
          });
        }
        shareDialog?.addEventListener('click', (event) => {
          if (event.target === shareDialog) shareDialog.close();
        });
        document.querySelector<HTMLButtonElement>('#share-copy')?.addEventListener('click', async (event) => {
          const button = event.currentTarget as HTMLButtonElement;
          const shareUrl = shareDialog?.dataset.shareUrl;
          if (!shareUrl) return;
          try {
            await navigator.clipboard.writeText(shareUrl);
            if (shareStatus) shareStatus.textContent = '网址已复制，现在可以发送给朋友。';
            button.textContent = '已复制';
            window.setTimeout(() => { button.textContent = '复制链接'; }, 2200);
          } catch {
            shareUrlInput?.focus();
            shareUrlInput?.select();
            if (shareStatus) shareStatus.textContent = '网址已选中，请手动复制。';
          }
        });

        // 每个对话框里都有一个 × / 完成，节点随页面更换，所以每次换页重新绑。
        document.querySelectorAll<HTMLButtonElement>('[data-dialog-close]').forEach((button) => {
          button.addEventListener('click', () => button.closest('dialog')?.close());
        });

        progressFill = document.querySelector<HTMLElement>('#reading-progress-fill');
        progressArticle = document.querySelector<HTMLElement>('.article-body');
        articleObserver?.disconnect();
        articleObserver = null;
        if (progressArticle && 'ResizeObserver' in window) {
          articleObserver = new ResizeObserver(scheduleScrollState);
          articleObserver.observe(progressArticle);
        }

        toTopButton = document.querySelector<HTMLButtonElement>('[data-to-top]');
        if (toTopButton) {
          if (document.querySelector('.article-page')) toTopButton.classList.add('to-top-raised');
          toTopButton.addEventListener('click', () => {
            const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
            document.querySelector<HTMLElement>('#main-content')?.focus({ preventScroll: true });
          });
        }
        updateScrollState();
      }

      function initSite() {
        // 同一份 DOM 只绑一次：首屏 astro:page-load 可能与下面的兜底调用先后撞上。
        if (boundGeneration === pageGeneration) return;
        boundGeneration = pageGeneration;
        bindPage();
      }

      // —— 全站只注册一次的监听 ——
      window.addEventListener('scroll', scheduleScrollState, { passive: true });
      window.addEventListener('resize', scheduleScrollState, { passive: true });

      document.addEventListener('click', (event) => {
        if (!headerEl || menuToggle?.getAttribute('aria-expanded') !== 'true') return;
        if (event.target instanceof Node && headerEl.contains(event.target)) return;
        closeMenu();
      });

      document.addEventListener('keydown', (event) => {
        if (menuToggle?.getAttribute('aria-expanded') === 'true') {
          if (event.key === 'Escape') closeMenu(true);
          else if (['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Home', 'End', ' '].includes(event.key)) closeMenu();
        }
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          openSearch();
        }
      });

      window.addEventListener('wheel', () => {
        if (menuToggle?.getAttribute('aria-expanded') === 'true') closeMenu();
      }, { passive: true });
      window.addEventListener('touchmove', () => {
        if (menuToggle?.getAttribute('aria-expanded') === 'true') closeMenu();
      }, { passive: true });

      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
      systemTheme.addEventListener?.('change', () => {
        if (preferences.theme === 'system') paintPreferences();
      });

      // 换页顺序：astro:before-swap → 换 DOM → astro:after-swap → 脚本 → astro:page-load。
      // <html> 上的阅读偏好在换 DOM 时会被新文档覆盖，趁 after-swap 补回来，
      // 这时新画面还没截图，读者不会看到浅色闪一下。
      document.addEventListener('astro:after-swap', () => {
        pageGeneration += 1;
        paintPreferences();
      });

      document.addEventListener('astro:page-load', () => {
        initSite();
        fillSearchFromUrl();
      });

      // 兜底：如果模块比 window load 还晚（极慢的连接），page-load 已经错过了。
      if (document.readyState === 'complete') {
        initSite();
        fillSearchFromUrl();
      }
    </script>
    <script>
      // 滚动显影：CSS 里的 [data-reveal] 全靠 will-reveal / is-revealed 两个类切换，
      // 少这段脚本，全站的 home-section、category-list 都不会动。
      // 单页路由换页时这段不会重跑（模块只执行一次）：新内容直接可见，入场动效交给
      // 页面级的纸页淡入，避免新画面截图时整屏还是隐藏状态、过渡完才「跳」出来。
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -22px 0px', threshold: 0.07 });
        document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((target) => {
          target.classList.add('will-reveal');
          observer.observe(target);
        });
      }
    </script>
    <script>
      // 「← 返回」：读者是从站内某个页面点进来的，就回到那一页（浏览器后退，滚动位置也还原）；
      // 直接打开链接或从外部站点进来时，href 里的兜底地址生效。
      // 单页路由下 document.referrer 只在进站那一次有效，之后换页不会更新，
      // 所以另外记一个「站内已经翻过页」的标记。用捕获阶段挂，抢在路由器接管链接之前。
      let spaNavigated = false;
      document.addEventListener('astro:after-swap', () => { spaNavigated = true; });
      document.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement | null)?.closest<HTMLAnchorElement>('[data-back-link]');
        if (!link) return;
        let cameFromHere = spaNavigated;
        if (!cameFromHere) {
          try {
            cameFromHere = Boolean(document.referrer) && new URL(document.referrer).origin === location.origin;
          } catch {
            cameFromHere = false;
          }
        }
        if (!cameFromHere || history.length <= 1) return;
        // 阻止默认跳转就够了：路由器在冒泡阶段，会看到 defaultPrevented 而放过这一下。
        event.preventDefault();
        history.back();
      }, true);
    </script>  </body>
</html>
