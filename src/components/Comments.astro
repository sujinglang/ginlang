---
/**
 * Per-article comments, powered by Waline.
 *
 * The blog itself stays static; the server URL is read from the public
 * runtime setting so one build can be pointed at any Waline instance. Until a
 * server is configured the section explains itself instead of rendering a
 * broken widget.
 */
const sectionId = `comments-${Astro.props.id}`;
---

<section class="article-comments" id="comments" aria-labelledby={sectionId}>
  <div class="comments-head">
    <span class="folio-mark">留言</span>
    <h2 id={sectionId}>读完可以说一句</h2>
    <p>不需要注册，填个名字就能留言。留下的内容会公开显示。</p>
  </div>
  <div class="waline-host" data-comments data-server={Astro.props.serverURL ?? ''}></div>
  <noscript><p class="comments-note">留言需要开启 JavaScript。</p></noscript>
</section>

<style>
  .article-comments {
    max-width: var(--reading-width);
    margin: 52px auto 0;
    padding-top: 38px;
    border-top: 1px solid var(--line);
  }
  .comments-head { margin-bottom: 26px; }
  .comments-head h2 { margin: 7px 0 6px; font-size: 21px; font-weight: 500; }
  .comments-head p { margin: 0; color: var(--muted); font: 13px/1.85 var(--serif); }
  .waline-host { min-height: 96px; }
  .comments-note { margin: 0; color: var(--muted); font: 13px/1.8 var(--serif); }
  /* Waline renders its own chrome; these rules only settle the paper surface
     and let the night theme pass through. */
  .waline-host :global(.wl-panel) { background: transparent; }
  .waline-host :global(.wl-card) {
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--paper-raised);
    box-shadow: none;
  }
  .waline-host :global(.wl-head),
  .waline-host :global(.wl-meta-head),
  .waline-host :global(.wl-footer) { background: transparent; }
  .waline-host :global(.wl-quote),
  .waline-host :global(.wl-comment) { border-color: var(--line); }
  .waline-host :global(input),
  .waline-host :global(textarea),
  .waline-host :global(button) {
    border-radius: 0;
    font-family: var(--sans);
    transition: border-color 180ms ease;
  }
  .waline-host :global(input:focus-visible),
  .waline-host :global(textarea:focus-visible),
  .waline-host :global(button:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  @media (max-width: 680px) {
    .article-comments { margin-top: 40px; padding-top: 30px; }
  }
</style>

<script define:vars={{ serverURL: Astro.props.serverURL ?? '' }}>
  // Waline is loaded only when a server is configured and only once per page.
  const mount = async () => {
    const host = document.querySelector('[data-comments]');
    if (!host || host.dataset.mounted === 'true' || !serverURL) return;
    host.dataset.mounted = 'true';
    try {
      const { init } = await import('@waline/client');
      init({
        el: host.querySelector('.waline-host'),
        serverURL,
        path: window.location.pathname,
        lang: 'zh-CN',
        // Readers may stay anonymous; a name is enough to leave a note.
        requiredMeta: ['nick'],
        pageSize: 10,
        dark: document.documentElement.dataset.theme === 'dark' ? 'css' : '',
        commentSorting: 'latest',
      });
    } catch {
      host.dataset.mounted = 'false';
      const note = document.createElement('p');
      note.className = 'comments-note';
      note.textContent = '留言暂时无法加载，稍后再试。';
      host.append(note);
    }
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mount, { once: true });
  else mount();
  document.addEventListener('astro:page-load', mount);
</script>