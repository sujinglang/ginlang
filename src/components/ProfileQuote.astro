---
interface Props {
  quote: string;
  source?: string;
  quoteEnglish?: string;
}
const { quote, source, quoteEnglish } = Astro.props;
---

<blockquote class="profile-quote">
  {quoteEnglish && <p class="profile-quote-english" lang="en" translate="no">“{quoteEnglish}”</p>}
  <p class="profile-quote-chinese">“{quote}”</p>
  {source && <cite>{source}</cite>}
</blockquote>