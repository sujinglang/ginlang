---
interface Props {
  size?: 'sm' | 'md';
  class?: string;
}

const { size = 'md', class: className = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<span class={`quiet-butterfly quiet-butterfly--${size} ${className}`.trim()} aria-hidden="true">
  <img src={base + '/goddess-butterfly.webp'} width="720" height="480" alt="" decoding="async" />
</span>
