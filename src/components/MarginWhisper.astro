---
import { allWhispers, type WhisperTheme } from '../data/whispers';

interface Props {
  theme: WhisperTheme;
}

const { theme } = Astro.props;
const first = allWhispers[0];
---

<script is:inline>
  document.documentElement.classList.add('whisper-initializing');
  window.setTimeout(() => document.documentElement.classList.remove('whisper-initializing'), 2500);
</script>
<aside class="margin-whisper" data-whisper data-whisper-theme={theme} aria-label="页边札记">
  <div class="margin-whisper-heading">
    <span>一则页边札记</span>
  </div>
  <div class="margin-whisper-content">
    <span class="margin-whisper-quote" aria-hidden="true">"</span>
    <div class="margin-whisper-body">
      <p data-whisper-text aria-live="polite">{first.text}</p>
      <cite data-whisper-source hidden={!first.source}>{first.source}</cite>
    </div>
    <button type="button" data-whisper-next aria-label="换一句页边札记">换一句 <span aria-hidden="true">↻</span></button>
  </div>
</aside>

<script>
  import { allWhispers } from '../data/whispers';

  function initWhispers() {
    document.querySelectorAll<HTMLElement>('[data-whisper]:not([data-whisper-ready])').forEach((note) => {
      const lines = allWhispers;
      const text = note.querySelector<HTMLElement>('[data-whisper-text]');
      const source = note.querySelector<HTMLElement>('[data-whisper-source]');
      const button = note.querySelector<HTMLButtonElement>('[data-whisper-next]');
      if (!lines?.length || !text || !source || !button) return;

      note.dataset.whisperReady = 'true';
      const key = 'ginlang-whisper-bag-all-v3';
      let previous = -1;
      let remaining: number[] = [];
      try {
        const raw = sessionStorage.getItem(key);
        if (raw) {
          const saved = JSON.parse(raw) as { count?: number; remaining?: number[]; last?: number };
          if (saved.count === lines.length && Array.isArray(saved.remaining)
            && saved.remaining.every((index) => Number.isInteger(index) && index >= 0 && index < lines.length)
            && new Set(saved.remaining).size === saved.remaining.length) {
            remaining = saved.remaining;
            if (Number.isInteger(saved.last) && saved.last! >= 0 && saved.last! < lines.length) previous = saved.last!;
          }
        }
      } catch {
        // The note remains usable without browser storage.
      }

      const authorOf = (index: number) => lines[index].source.split('《')[0].trim();
      function refill() {
        const groups = new Map<string, number[]>();
        lines.forEach((_, index) => {
          const author = authorOf(index);
          if (!groups.has(author)) groups.set(author, []);
          groups.get(author)!.push(index);
        });
        for (const group of groups.values()) {
          for (let index = group.length - 1; index > 0; index -= 1) {
            const other = Math.floor(Math.random() * (index + 1));
            [group[index], group[other]] = [group[other], group[index]];
          }
        }

        const order: number[] = [];
        let lastAuthor = previous < 0 ? '' : authorOf(previous);
        while (order.length < lines.length) {
          const left = lines.length - order.length;
          const valid = [...groups.entries()].filter(([author, group]) => {
            if (!group.length || author === lastAuthor) return false;
            const counts = [...groups.entries()].map(([name, entries]) => entries.length - Number(name === author));
            const largest = Math.max(...counts);
            const largestAuthor = [...groups.keys()][counts.indexOf(largest)];
            return largest <= left - 1 - largest + Number(largestAuthor !== author);
          });
          // A single-author library cannot alternate; still show every line.
          const choices = valid.length ? valid : [...groups.entries()].filter(([, group]) => group.length);
          const total = choices.reduce((sum, [, group]) => sum + group.length, 0);
          let ticket = Math.floor(Math.random() * total);
          const [author, group] = choices.find(([, entries]) => (ticket -= entries.length) < 0)!;
          order.push(group.pop()!);
          lastAuthor = author;
        }
        remaining = order.reverse();
      }

      function nextLine() {
        if (!remaining.length) refill();
        const index = remaining.pop() ?? 0;
        previous = index;
        const line = lines[index];
        text.textContent = line.text;
        source.textContent = line.source ?? '';
        source.hidden = !line.source;
        if (note.dataset.whisperShown === 'true') {
          text.classList.remove('whisper-swapping');
          void text.offsetWidth;
          text.classList.add('whisper-swapping');
        }
        note.dataset.whisperShown = 'true';
        document.documentElement.classList.remove('whisper-initializing');
        try { sessionStorage.setItem(key, JSON.stringify({ count: lines.length, remaining, last: index })); } catch { /* Storage is optional. */ }
      }

      nextLine();
      button.addEventListener('click', nextLine);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWhispers, { once: true });
  } else {
    initWhispers();
  }
  document.addEventListener('astro:page-load', initWhispers);
</script>
