---
// A short thought to carry into the reader's own writing.
const prompts = [
  '傍晚的街道会慢慢安静下来，白天没有听清的话，常在这时重新响起。把那句话写下来，也许能看见自己真正介意的事。',
  '有些决定并没有一个响亮的开始。只是某天起，你不再按照别人的期待安排自己的时间。',
  '一段关系里最难忘的，未必是郑重的承诺。也可能是一个人记得你的习惯，在普通的一天为你留了一盏灯。',
  '人会在熟悉的路上走很久，直到某个平常的早晨，才察觉自己想看的风景已经变了。',
  '真正属于自己的时间，有时只有晚饭后的一小段。那一小段如何度过，也在悄悄决定生活的样子。',
  '道歉之后，事情不一定立刻变好。但愿意把话说清楚，已经让沉默不再替两个人作决定。',
  '有些离开没有戏剧性的告别。只是下一次想分享见闻时，你不再第一个想到那个人。',
  '坚持并不总是向前跑。照常起床，认真吃饭，在失意的日子里把日子过下去，也是一种坚持。',
  '自由并不只发生在远方。关掉一则让人焦虑的消息，留下一个不被打扰的下午，也是自由的形状。',
  '有些愿望迟迟没有实现，并不说明那些年白过了。你走过的路，已经改变了你看待世界的方式。',
  '在亲近的人面前，我们常以为对方能听懂没有说出的部分。那些被省略的话，久了也会成为距离。',
  '一天结束时，真正留下来的常是很小的事。一顿合口的饭，一句恰好的回应，或者一段没有赶路的时间。',
  '生活不会替人把每条路的尽头照亮。先走一段，再停下来辨认方向，也是一种认真的选择。',
  '有些安稳让人安心，有些安稳只是让人不敢挪动。它们看起来相似，身在其中的感受却不会相同。',
  '不再羡慕另一种生活的时候，眼前的生活未必立刻变好。但你终于可以看清，哪些地方值得自己动手改变。',
  '一件事做得久了，热爱与习惯会长得很像。偶尔放慢脚步，才听得见心里那一点细微的差别。',
  '爱不是替另一个人把路走完。并肩走过一程，允许彼此有不同的步子，也是一种靠近。',
  '雨停之后，路面不会马上干。很多事情也是如此，结束已经发生，心里仍需要一点时间。',
];
---

<section class="daily-note" aria-labelledby="daily-note-title" data-daily-note data-prompts={JSON.stringify(prompts)}>
  <div class="note-intro">
    <p class="note-kicker">留给读者的一页</p>
    <h2 id="daily-note-title">抽一张<br /><em>今日笺。</em></h2>
    <p class="note-description">读完这一段，停一会儿。把想到的人和事写在下面；这些句子只留在你的浏览器里。</p>
    <button class="draw-button" type="button" data-draw hidden>
      <span>再抽一张</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
        <path d="M20 11a8 8 0 1 0-2.1 6.3M20 5v6h-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <div class="daily-note-workspace"><div class="note-paper" data-paper>
    <div class="paper-topline" aria-hidden="true">
      <span>GINLANG</span>
      <span>一页偶然</span>
    </div>
    <span class="opening-mark" aria-hidden="true">“</span>
    <p class="prompt" aria-live="polite" aria-atomic="true" data-prompt>{prompts[0]}</p>
    <div class="paper-footline" aria-hidden="true">
      <span>读完，再写自己的那一段</span>
      <span>GINLANG</span>
    </div>
  </div>
    <label class="note-draft-label" for="note-draft">写在这里</label>
    <textarea id="note-draft" data-note-draft rows="4" placeholder="从一件具体的事写起。"></textarea>
    <div class="note-draft-tools"><small>草稿只保存在你当前的浏览器。</small><div><button type="button" data-note-copy>复制</button><button type="button" data-note-clear>清空</button></div></div>
    <p class="note-draft-status" role="status" data-note-status></p>
  </div>
</section>

<script>
  function initDailyNotes() {
    document.querySelectorAll<HTMLElement>('[data-daily-note]').forEach((root) => {
      if (root.dataset.ready === 'true') return;

      const button = root.querySelector<HTMLButtonElement>('[data-draw]');
      const paper = root.querySelector<HTMLElement>('[data-paper]');
      const prompt = root.querySelector<HTMLElement>('[data-prompt]');
      let notes: string[] = [];

      try {
        notes = JSON.parse(root.dataset.prompts ?? '[]');
      } catch {
        return;
      }
      if (!button || !paper || !prompt || notes.length < 2) return;

      root.dataset.ready = 'true';
      button.hidden = false;
      const draft = root.querySelector<HTMLTextAreaElement>('[data-note-draft]');
      const status = root.querySelector<HTMLElement>('[data-note-status]');
      const draftKey = 'ginlang-reader-note';
      if (draft) {
        try { draft.value = localStorage.getItem(draftKey) ?? ''; } catch { /* Draft remains editable. */ }
        draft.addEventListener('input', () => {
          try { localStorage.setItem(draftKey, draft.value); } catch { /* Storage is optional. */ }
          if (status) status.textContent = draft.value ? '已保存在当前浏览器' : '';
        });
      }
      root.querySelector<HTMLButtonElement>('[data-note-clear]')?.addEventListener('click', () => {
        if (!draft) return;
        draft.value = '';
        try { localStorage.removeItem(draftKey); } catch { /* Storage is optional. */ }
        if (status) status.textContent = '已清空';
        draft.focus();
      });
      root.querySelector<HTMLButtonElement>('[data-note-copy]')?.addEventListener('click', async () => {
        if (!draft?.value.trim()) { draft?.focus(); if (status) status.textContent = '先写下你的想法，再复制。'; return; }
        try { await navigator.clipboard.writeText(draft.value); if (status) status.textContent = '已复制'; }
        catch { draft.focus(); draft.select(); if (status) status.textContent = '已选中草稿，请手动复制。'; }
      });
      let current = 0;
      let changing = false;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      try {
        const raw = sessionStorage.getItem('ginlang-daily-note');
        const saved = raw === null ? -1 : Number(raw);
        if (Number.isInteger(saved) && saved >= 0 && saved < notes.length) current = saved;
      } catch {
        // The note can still rotate when browser storage is unavailable.
      }
      const firstPick = Math.floor(Math.random() * (notes.length - 1));
      current = firstPick >= current ? firstPick + 1 : firstPick;
      prompt.textContent = notes[current];
      try { sessionStorage.setItem('ginlang-daily-note', String(current)); } catch { /* Optional storage. */ }

      button.addEventListener('click', () => {
        if (changing) return;
        const nextPick = Math.floor(Math.random() * (notes.length - 1));
        const next = nextPick >= current ? nextPick + 1 : nextPick;

        const showNext = () => {
          current = next;
          prompt.textContent = notes[current];
          paper.classList.remove('is-changing');
          try { sessionStorage.setItem('ginlang-daily-note', String(current)); } catch { /* Optional storage. */ }
        };

        if (reducedMotion.matches) {
          showNext();
          return;
        }

        changing = true;
        paper.classList.add('is-changing');
        window.setTimeout(() => {
          showNext();
          window.setTimeout(() => { changing = false; }, 200);
        }, 140);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDailyNotes, { once: true });
  } else {
    initDailyNotes();
  }
  document.addEventListener('astro:page-load', initDailyNotes);
</script>

<style>
  .daily-note {
    display: grid;
    grid-template-columns: minmax(210px, 0.43fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
    margin: 59px 0 0;
    padding: 38px 0 42px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .note-kicker {
    margin: 0 0 17px;
    color: var(--clay);
    font: 10px/1.5 var(--sans);
    letter-spacing: 0.15em;
  }

  .note-intro h2 {
    margin: 0;
    font-size: clamp(26px, 3.6vw, 37px);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  .note-intro h2 em { color: var(--accent); font-style: normal; }

  .note-description {
    max-width: 23em;
    margin: 15px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.9;
  }

  .draw-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 15px;
    margin-top: 21px;
    padding: 5px 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: var(--accent-deep);
    cursor: pointer;
    font: 12px/1.5 var(--sans);
    transition: color 220ms ease, border-color 220ms ease;
  }

  .draw-button[hidden] { display: none; }
  .draw-button:hover { border-bottom-color: var(--clay); color: var(--ink); }
  .draw-button svg { width: 30px; height: 30px; padding: 7px; border: 1px solid var(--line); border-radius: 50%; transition: background-color 220ms ease, transform 220ms ease; }
  .draw-button:hover svg { background: var(--accent-soft); transform: rotate(28deg); }
  .draw-button:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }

  .note-paper {
    position: relative;
    display: flex;
    min-height: 300px;
    flex-direction: column;
    overflow: hidden;
    padding: 20px clamp(24px, 4vw, 42px) 22px;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    box-shadow: 7px 7px 0 color-mix(in srgb, var(--paper-soft) 72%, transparent);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }
  .daily-note-workspace { min-width: 0; }
  .note-draft-label { display: block; margin-top: 26px; color: var(--accent-deep); font: 14px/1.6 var(--sans); }
  [data-note-draft] { display: block; width: 100%; min-height: 108px; margin-top: 9px; padding: 13px 15px; resize: vertical; border: 1px solid var(--line); border-radius: 2px; background: var(--paper-raised); color: var(--ink); font: 15px/1.8 var(--serif); }
  [data-note-draft]::placeholder { color: var(--muted); opacity: .72; }
  .note-draft-tools { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; align-items: center; margin-top: 7px; }
  .note-draft-tools small { color: var(--muted); font: 11px/1.6 var(--sans); }
  .note-draft-tools > div { display: flex; gap: 13px; }
  .note-draft-tools button { min-height: 36px; padding: 5px 1px; border: 0; border-bottom: 1px solid var(--line); background: none; color: var(--accent-deep); cursor: pointer; font: 12px/1.5 var(--sans); }
  .note-draft-tools button:hover { border-bottom-color: var(--accent); }
  .note-draft-status { min-height: 1.5em; margin: 3px 0 0; color: var(--muted); font: 11px/1.5 var(--sans); }

  .note-paper.is-changing {
    transform: rotate(-0.8deg) translateY(-3px);
    box-shadow: 10px 12px 0 color-mix(in srgb, var(--paper-soft) 72%, transparent);
  }

  .note-paper::before {
    position: absolute;
    top: 0;
    left: clamp(24px, 4vw, 42px);
    width: 31px;
    height: 2px;
    background: var(--clay);
    content: '';
  }

  .paper-topline, .paper-footline {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    color: var(--muted);
    font: 9px/1.5 var(--sans);
    letter-spacing: 0.13em;
  }

  .paper-topline span:first-child { color: var(--accent); }
  .paper-footline { margin-top: auto; padding-top: 17px; border-top: 1px solid var(--line); }

  .opening-mark {
    height: 43px;
    margin-top: 15px;
    color: var(--clay);
    font: 58px/1 var(--serif);
  }

  .prompt {
    max-width: 26em;
    min-height: 6.3em;
    margin: 0 0 20px;
    font: 400 clamp(18px, 2.1vw, 22px)/1.85 var(--editorial-cn);
    letter-spacing: 0.015em;
    transition: opacity 140ms ease, transform 140ms ease;
  }

  .note-paper.is-changing .prompt { opacity: 0; transform: translateY(-5px); }

  @media (max-width: 680px) {
    .daily-note { grid-template-columns: 1fr; gap: 24px; margin-top: 43px; padding: 32px 0 38px; }
    .note-intro h2 br { display: none; }
    .note-description { margin-top: 8px; font-size: 12px; }
    .draw-button { margin-top: 12px; }
    .note-paper { min-height: 290px; padding: 18px 22px 20px; }
    .note-paper::before { left: 22px; }
    .opening-mark { margin-top: 8px; }
    .prompt { min-height: 7em; font-size: 19px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .draw-button, .prompt, .note-paper { transition: none; }
    .note-paper.is-changing { transform: none; }
    .note-paper.is-changing .prompt { opacity: 1; transform: none; }
  }
</style>
