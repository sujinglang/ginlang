---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="section-divider" aria-hidden="true">
  <img src={base + '/section-shanshui-v1.webp'} width="2172" height="724" alt="" loading="lazy" decoding="async" draggable="false" />
</div>

<style>
  .section-divider {
    position: relative;
    height: 80px;
    margin: clamp(14px, 1.6vw, 22px) 0 clamp(8px, 1vw, 14px);
    overflow: hidden;
    pointer-events: none;
  }
  .section-divider img {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    max-width: none;
    height: 240%;
    object-fit: fill;
    transform: translateY(-55%);
    opacity: .86;
    mix-blend-mode: multiply;
  }
  :global(.home-content) > .section-divider:nth-of-type(even) img {
    transform: translateY(-55%) scaleX(-1);
  }
  :global(:root[data-theme='dark']) .section-divider img {
    opacity: .58;
    mix-blend-mode: normal;
  }
  @media (max-width: 680px) {
    .section-divider { height: 48px; margin: 16px 0 12px; }
  }
</style>
