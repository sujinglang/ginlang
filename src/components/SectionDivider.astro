---
import waterWash from '../assets/section-water-wash.svg?url';
---

<div class="section-divider" style={{ '--section-wash': `url("${waterWash}")` }} aria-hidden="true"></div>

<style>
  .section-divider {
    height: 48px;
    margin: clamp(24px, 3vw, 46px) 0 clamp(12px, 1.5vw, 24px);
    background: var(--accent);
    opacity: .5;
    -webkit-mask: var(--section-wash) center / 100% 100% no-repeat;
    mask: var(--section-wash) center / 100% 100% no-repeat;
    pointer-events: none;
  }
  :global(.home-content) > .section-divider:nth-of-type(even) {
    transform: scaleX(-1);
  }
  @media (max-width: 680px) {
    .section-divider { height: 32px; margin: 24px 0 20px; }
  }
</style>
