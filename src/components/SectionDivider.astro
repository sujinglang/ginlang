---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="section-divider" aria-hidden="true">
  <img src={base + '/section-qianli-jiangshan-v1.webp'} width="2612" height="105" alt="" loading="lazy" decoding="async" draggable="false" />
</div>

<style>
  .section-divider {
    position: relative;
    aspect-ratio: 2172 / 260;
    margin: clamp(14px, 1.6vw, 22px) 0 clamp(8px, 1vw, 14px);
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .section-divider img {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    max-width: none;
    height: 60%;
    object-fit: cover;
    object-position: 45% center;
    transform: translateY(-50%);
    opacity: .48;
    filter: saturate(.48) contrast(.68) brightness(2.05);
    mask-image: linear-gradient(to bottom, transparent, #000 16%, #000 72%, transparent);
    mix-blend-mode: multiply;
  }
  :global(.home-content) > .section-divider:nth-of-type(even) img {
    object-position: 75% center;
  }
  :global(:root[data-theme='dark']) .section-divider img {
    opacity: .35;
    mix-blend-mode: screen;
    filter: grayscale(1) contrast(.7) brightness(1.9) invert(1);
  }
  @media (max-width: 680px) {
    .section-divider { margin: 16px 0 12px; }
  }
</style>
