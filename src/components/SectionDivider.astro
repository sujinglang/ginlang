---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const illustrations = {
  landscape: { file: 'section-ink-landscape-v5.webp', width: 2172, height: 724 },
  study: { file: 'section-ink-study-v1.webp', width: 2171, height: 724 },
  reeds: { file: 'section-ink-reeds-v1.webp', width: 2172, height: 724 },
} as const;

interface Props {
  art?: keyof typeof illustrations;
}

const { art } = Astro.props;
const illustration = art ? illustrations[art] : undefined;
---

<div class:list={['section-divider', art && 'section-divider--' + art, { 'section-divider--space': !illustration }]} data-divider-art={art} aria-hidden="true">
  {illustration && <img src={base + '/' + illustration.file} width={illustration.width} height={illustration.height} alt="" loading="lazy" decoding="async" draggable="false" />}
</div>

<style>
  .section-divider {
    position: relative;
    aspect-ratio: 2172 / 260;
    margin: clamp(14px, 1.6vw, 22px) 0 clamp(8px, 1vw, 14px);
    overflow: hidden;
    pointer-events: none;
  }
  .section-divider--space {
    aspect-ratio: auto;
    height: clamp(30px, 4vw, 50px);
  }
  .section-divider img {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    max-width: none;
    height: auto;
    transform: translateY(-50%);
    opacity: .86;
    mix-blend-mode: multiply;
  }
  .section-divider--study img {
    transform: translateY(-46%);
    opacity: .78;
  }
  .section-divider--reeds img {
    opacity: .78;
  }
  :global(:root[data-theme='dark']) .section-divider img {
    opacity: .58;
    mix-blend-mode: screen;
    filter: grayscale(1) invert(1);
  }
  @media (max-width: 680px) {
    .section-divider { margin: 16px 0 12px; }
  }
</style>
