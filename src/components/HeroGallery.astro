---
import Butterfly from './Butterfly.astro';
import { heroImages } from '../data/heroWatercolors';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const slides = heroImages;
const slideIds = slides.map(({ id }) => id);
const slideSrcs = Object.fromEntries(slides.map((slide) => [slide.id, base + '/hero-watercolors/' + slide.file]));
---

<!-- Run before the images exist so a refresh never paints a default slide first. -->
<script is:inline define:vars={{ slideIds, slideSrcs }}>
  (() => {
    const key = 'ginlang-hero-current';
    let previous = '';
    try { previous = sessionStorage.getItem(key) || ''; } catch { /* Storage is optional. */ }
    const choices = slideIds.filter((id) => id !== previous);
    const start = choices[Math.floor(Math.random() * choices.length)] || slideIds[0];
    window.__ginlangHeroStartId = start;
    try { sessionStorage.setItem(key, start); } catch { /* Storage is optional. */ }
    // Begin fetching the first painting while the rest of the page is still parsing.
    const src = slideSrcs[start];
    if (src) {
      const preload = document.createElement('link');
      preload.rel = 'preload';
      preload.as = 'image';
      preload.href = src;
      preload.fetchPriority = 'high';
      document.head.append(preload);
    }
  })();
</script>

<style>
  .hero-gallery-frame { display: block; padding: 0; color: inherit; cursor: zoom-in; }
  .hero-gallery-frame:disabled { cursor: default; }
  .hero-gallery-frame:hover:not(:disabled) { border-color: var(--accent); }
  .gallery-lightbox { width: min(94vw, 960px); max-width: none; max-height: 94vh; padding: 18px; border: 1px solid var(--line); background: var(--paper-raised); color: var(--ink); box-shadow: 0 20px 75px rgb(29 35 29 / 18%); }
  .gallery-lightbox::backdrop { background: rgb(33 39 34 / 70%); }
  .gallery-lightbox > img { display: block; width: 100%; height: min(76vh, 760px); object-fit: contain; background: var(--paper); }
  .gallery-lightbox-close { position: absolute; top: 22px; right: 22px; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 50%; background: var(--paper-raised); color: var(--ink); cursor: pointer; font: 25px/1 var(--sans); }
  .gallery-lightbox-bottom { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding-top: 12px; color: var(--muted); font: 12px/1.6 var(--serif); }
  .gallery-lightbox-bottom > div { display: flex; gap: 16px; flex: 0 0 auto; }
  .gallery-lightbox-bottom button { min-height: 44px; padding: 5px 0; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--accent-deep); cursor: pointer; font: 12px/1.5 var(--sans); }
  .gallery-lightbox-bottom button:hover { border-bottom-color: var(--clay); color: var(--ink); }
  @media (max-width: 680px) { .gallery-lightbox { width: calc(100vw - 20px); padding: 10px; } .gallery-lightbox > img { height: min(73vh, 700px); } .gallery-lightbox-close { top: 14px; right: 14px; } .gallery-lightbox-bottom { align-items: flex-start; flex-direction: column; gap: 2px; } }
</style>

<figure class="hero-gallery" id="home-gallery" data-hero-gallery aria-label="首页水彩画册">
  <button class="hero-gallery-frame" type="button" data-gallery-frame aria-label="细看当前画作" disabled>
    {slides.map((slide) => (
      <img
        class="hero-gallery-image"
        data-gallery-slide
        data-slide-id={slide.id}
        data-src={base + '/hero-watercolors/' + slide.file}
        width={slide.width}
        height={slide.height}
        alt={slide.alt}
        aria-hidden="true"
        decoding="async"
      />
    ))}
    <span class="hero-gallery-fallback" data-gallery-fallback hidden>画面暂时无法加载，请稍后再试。</span>
    <noscript>
      <img class="hero-gallery-nojs" src={base + '/hero-watercolors/' + slides[0].file} width={slides[0].width} height={slides[0].height} alt={slides[0].alt} />
    </noscript>
  </button>
  <div class="hero-gallery-controls" data-gallery-controls hidden>
    <div class="hero-gallery-actions" role="group" aria-label="画册操作">
      <button type="button" data-gallery-prev aria-label="上一张画" aria-keyshortcuts="ArrowLeft">← <span>上一张</span></button>
      <button type="button" data-gallery-next aria-label="下一张画" aria-keyshortcuts="ArrowRight"><span>下一张</span> →</button>
      <span class="hero-gallery-divider" aria-hidden="true"></span>
      <button type="button" data-gallery-play aria-label="暂停自动播放" aria-pressed="false">暂停</button>
    </div>
  </div>
  <figcaption class="hero-gallery-caption"><span>首页这几张，来自我的相册。</span><a href={base + '/album/'}>看看相簿</a></figcaption>
  <dialog class="gallery-lightbox" aria-label="细看水彩画" data-gallery-lightbox>
    <button class="gallery-lightbox-close" type="button" data-gallery-lightbox-close aria-label="关闭画作">×</button>
    <img data-gallery-lightbox-image alt="" width="1536" height="1536" />
    <div class="gallery-lightbox-bottom"><span data-gallery-lightbox-caption></span><div><button type="button" data-gallery-lightbox-prev>上一张</button><button type="button" data-gallery-lightbox-next>下一张</button></div></div>
  </dialog>
  <Butterfly size="md" />
</figure>

<script>
  function initHeroGallery() {
    const gallery = document.querySelector<HTMLElement>('[data-hero-gallery]:not([data-gallery-ready])');
    if (!gallery) return;
    gallery.dataset.galleryReady = 'true';

    const images = [...gallery.querySelectorAll<HTMLImageElement>('[data-gallery-slide]')];
    const frame = gallery.querySelector<HTMLButtonElement>('[data-gallery-frame]');
    const controls = gallery.querySelector<HTMLElement>('[data-gallery-controls]');
    const previousButton = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]');
    const nextButton = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const playButton = gallery.querySelector<HTMLButtonElement>('[data-gallery-play]');
    const fallback = gallery.querySelector<HTMLElement>('[data-gallery-fallback]');
    const lightbox = gallery.querySelector<HTMLDialogElement>('[data-gallery-lightbox]');
    const lightboxImage = gallery.querySelector<HTMLImageElement>('[data-gallery-lightbox-image]');
    const lightboxCaption = gallery.querySelector<HTMLElement>('[data-gallery-lightbox-caption]');
    if (!images.length || !frame || !controls || !previousButton || !nextButton || !playButton || !fallback) return;

    const key = 'ginlang-hero-current';
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const loaded = new Map<number, Promise<boolean>>();
    const failed = new Set<number>();
    let current = -1;
    let timer = 0;
    let request = 0;
    let leaveTimer = 0;
    let hovering = false;
    let focused = false;
    let userPaused = false;
    let userRequestedPlay = false;
    let touchStart: { x: number; y: number } | null = null;
    let modalOpen = false;
    let swiped = false;

    const isPaused = () => userPaused || (motion.matches && !userRequestedPlay);
    const remember = (index: number) => {
      try { sessionStorage.setItem(key, images[index].dataset.slideId || ''); } catch { /* Storage is optional. */ }
    };
    const clearTimer = () => {
      if (timer) window.clearTimeout(timer);
      timer = 0;
    };
    const updatePlayButton = () => {
      const paused = isPaused();
      playButton.textContent = paused ? '播放' : '暂停';
      playButton.setAttribute('aria-label', paused ? '继续自动播放' : '暂停自动播放');
      playButton.setAttribute('aria-pressed', String(paused));
    };
    const schedule = () => {
      clearTimer();
      if (current < 0 || isPaused() || hovering || focused || modalOpen || document.hidden || failed.size >= images.length - 1) return;
      timer = window.setTimeout(() => { void move(1); }, 6000);
    };
    const ensureLoaded = (index: number) => {
      if (failed.has(index)) return Promise.resolve(false);
      const existing = loaded.get(index);
      if (existing) return existing;
      const image = images[index];
      const pending = new Promise<boolean>((resolve) => {
        image.onload = async () => {
          try { await image.decode(); } catch { /* The loaded image can still be shown. */ }
          resolve(true);
        };
        image.onerror = () => {
          failed.add(index);
          resolve(false);
        };
        image.loading = 'eager';
        if (current < 0) image.fetchPriority = 'high';
        image.src = image.dataset.src || '';
        if (image.complete && image.naturalWidth > 0) image.onload?.(new Event('load'));
      });
      loaded.set(index, pending);
      return pending;
    };
    const warmNext = (from: number) => {
      for (let offset = 1; offset < images.length; offset += 1) {
        const index = (from + offset) % images.length;
        if (failed.has(index)) continue;
        void ensureLoaded(index).then((ok) => { if (!ok) warmNext(from); });
        return;
      }
    };
    const activate = async (target: number, direction: number) => {
      clearTimer();
      const thisRequest = ++request;
      let index = target;
      for (let attempt = 0; attempt < images.length; attempt += 1) {
        if (!failed.has(index) && await ensureLoaded(index)) {
          if (thisRequest !== request) return;
          if (leaveTimer) window.clearTimeout(leaveTimer);
          images.forEach((image, imageIndex) => {
            const active = imageIndex === index;
            image.classList.toggle('is-leaving', imageIndex === current && !active);
            image.classList.toggle('is-active', active);
            image.setAttribute('aria-hidden', String(!active));
          });
          leaveTimer = window.setTimeout(() => {
            images.forEach((image) => image.classList.remove('is-leaving'));
            leaveTimer = 0;
          }, 760);
          current = index;
          frame.disabled = false;
          frame.setAttribute('aria-label', '细看画作：' + images[index].alt);
          if (modalOpen && lightboxImage) {
            lightboxImage.src = images[index].src;
            lightboxImage.alt = images[index].alt;
            if (lightboxCaption) lightboxCaption.textContent = images[index].alt;
          }
          controls.hidden = false;
          remember(index);
          warmNext(index);
          schedule();
          return;
        }
        if (thisRequest !== request) return;
        index = (index + direction + images.length) % images.length;
      }
      fallback.hidden = false;
      controls.hidden = true;
    };
    const move = (direction: number) => {
      clearTimer();
      const index = current < 0 ? 0 : (current + direction + images.length) % images.length;
      return activate(index, direction);
    };

    previousButton.addEventListener('click', () => { void move(-1); });
    nextButton.addEventListener('click', () => { void move(1); });
    frame.addEventListener('click', (event) => {
      if (swiped) { event.preventDefault(); swiped = false; return; }
      if (!lightbox || !lightboxImage || current < 0) return;
      modalOpen = true;
      clearTimer();
      lightboxImage.src = images[current].src;
      lightboxImage.alt = images[current].alt;
      if (lightboxCaption) lightboxCaption.textContent = images[current].alt;
      lightbox.showModal();
      gallery.querySelector<HTMLButtonElement>('[data-gallery-lightbox-close]')?.focus();
    });
    gallery.querySelector<HTMLButtonElement>('[data-gallery-lightbox-close]')?.addEventListener('click', () => lightbox?.close());
    gallery.querySelector<HTMLButtonElement>('[data-gallery-lightbox-prev]')?.addEventListener('click', () => { void move(-1); });
    gallery.querySelector<HTMLButtonElement>('[data-gallery-lightbox-next]')?.addEventListener('click', () => { void move(1); });
    lightbox?.addEventListener('close', () => { modalOpen = false; frame.focus(); focused = frame.matches(':focus-visible'); schedule(); });
    gallery.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        void move(-1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        void move(1);
      }
    });
    playButton.addEventListener('click', () => {
      if (isPaused()) {
        userPaused = false;
        userRequestedPlay = true;
      } else {
        userPaused = true;
        userRequestedPlay = false;
      }
      updatePlayButton();
      schedule();
    });
    gallery.addEventListener('mouseenter', () => { hovering = true; clearTimer(); });
    gallery.addEventListener('mouseleave', () => { hovering = false; schedule(); });
    gallery.addEventListener('focusin', (event) => {
      if (event.target instanceof HTMLElement && event.target.matches(':focus-visible')) {
        focused = true;
        clearTimer();
      }
    });
    gallery.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && gallery.contains(event.relatedTarget)) return;
      focused = false;
      schedule();
    });
    document.addEventListener('visibilitychange', schedule);
    motion.addEventListener('change', () => {
      if (motion.matches) userRequestedPlay = false;
      updatePlayButton();
      schedule();
    });
    frame.addEventListener('touchstart', (event) => {
      const touch = event.changedTouches[0];
      if (touch) touchStart = { x: touch.clientX, y: touch.clientY };
    }, { passive: true });
    frame.addEventListener('touchend', (event) => {
      if (!touchStart) return;
      const touch = event.changedTouches[0];
      if (!touch) return;
      const dx = touch.clientX - touchStart.x;
      const dy = touch.clientY - touchStart.y;
      touchStart = null;
      if (Math.abs(dx) >= 42 && Math.abs(dx) > Math.abs(dy) * 1.35) {
        swiped = true;
        void move(dx < 0 ? 1 : -1);
        window.setTimeout(() => { swiped = false; }, 500);
      }
    }, { passive: true });
    frame.addEventListener('touchcancel', () => { touchStart = null; }, { passive: true });
    lightboxImage?.addEventListener('touchstart', (event) => {
      const touch = event.changedTouches[0];
      if (touch) touchStart = { x: touch.clientX, y: touch.clientY };
    }, { passive: true });
    lightboxImage?.addEventListener('touchend', (event) => {
      if (!touchStart) return;
      const touch = event.changedTouches[0];
      if (!touch) return;
      const dx = touch.clientX - touchStart.x;
      const dy = touch.clientY - touchStart.y;
      touchStart = null;
      if (Math.abs(dx) >= 42 && Math.abs(dx) > Math.abs(dy) * 1.35) void move(dx < 0 ? 1 : -1);
    }, { passive: true });

    updatePlayButton();
    const chosenId = (window as Window & { __ginlangHeroStartId?: string }).__ginlangHeroStartId;
    const matchedStart = images.findIndex((image) => image.dataset.slideId === chosenId);
    const start = matchedStart >= 0 ? matchedStart : Math.floor(Math.random() * images.length);
    void activate(start, 1);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroGallery, { once: true });
  } else {
    initHeroGallery();
  }
  document.addEventListener('astro:page-load', initHeroGallery);
</script>
